# Reaper language facade for the versioned Pytyliki mathematical research kernels.
# Every wrapper returns a validated call plan; none executes native code.

export craft catalog() {
    yield research_kernel_catalog()
}

export craft kernel_plan(function_id, arguments) {
    yield research_kernel_plan(function_id, arguments)
}

# Riemann Hypothesis
export craft riemann_dirichlet_partial(sigma, t, terms) {
    yield research_kernel_plan("riemann.dirichlet_partial", [sigma, t, terms])
}

export craft riemann_eta_partial(sigma, t, terms) {
    yield research_kernel_plan("riemann.eta_partial", [sigma, t, terms])
}

export craft riemann_critical_residual(t, terms) {
    yield research_kernel_plan("riemann.critical_residual", [t, terms])
}

# P versus NP
export craft p_vs_np_cnf_validate(variables, literals, literal_count, clause_offsets, clause_count) {
    yield research_kernel_plan("complexity.cnf_validate", [variables, literals, literal_count, clause_offsets, clause_count])
}

export craft p_vs_np_sat_verify(variables, literals, literal_count, clause_offsets, clause_count, assignment) {
    yield research_kernel_plan("complexity.sat_verify", [variables, literals, literal_count, clause_offsets, clause_count, assignment])
}

export craft p_vs_np_sat_find_bounded(variables, literals, literal_count, clause_offsets, clause_count, assignment_budget) {
    yield research_kernel_plan("complexity.sat_find_bounded", [variables, literals, literal_count, clause_offsets, clause_count, assignment_budget])
}

