# Reaper Processor Engineering Workbench v1.
# The report is generated by the separately built Pytyliki C11 workstation.

import "../../stdlib/processor_workbench.rpr" as pew
import "../../stdlib/typed_registry.rpr" as typed

make manifest := read_json("examples/processor-workspace/x86_64-linux.project.json")
make host_report := read_json("build/pytyliki-processor-report.json")

make u64 := typed["scalar"]("u64", 64, false, 8)
make linux_x86_64 := typed["platform"](
    "linux-x86_64",
    "x86_64-unknown-linux-gnu",
    "x86_64",
    "linux",
    "SYSV64",
    64,
    "little",
    "sysv64",
    "hosted",
    ["sse2"],
    []
)
make registry := typed["registry"](
    "processor-workbench-host",
    "1.0.0",
    [linux_x86_64],
    [u64],
    []
)
make type_report := typed["validate"](registry)
assert(type_report[0], "Reaper typed target registry must accept the host ABI")

make project_report := pew["validate_project"](manifest)
assert(project_report[0], project_report[1])

make host_gate := pew["validate_host_report"](host_report, manifest)
assert(host_gate[0], host_gate[1])

make workspace := pew["make_workspace_report"](manifest, host_report)
assert(workspace[0], workspace[1])
write_json("build/processor-workbench-report.json", workspace[1])

emit "REAPER_PROCESSOR_WORKBENCH:PASS"
emit "TARGET_ABI:SYSV64"
emit "AOT_BACKEND:scalar-c17"
emit "HARDWARE_EFFECTS:NONE"
