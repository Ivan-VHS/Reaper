import "../frameworks/foundation_16_20.rpr" as runtime

emit "All twenty frameworks valid = " ++ text(runtime["foundation_validate_catalog_20"]())
emit "Lifecycle valid = " ++ text(runtime["runtime_validate_lifecycle"](["created", "initialized", "ready", "running", "draining", "stopped"]))
emit "Execution context valid = " ++ text(runtime["execution_validate_context"](runtime["execution_default_context"]()))
emit "Canonical VM route valid = " ++ text(runtime["engine_validate_selection"](["canonical-vm", "canonical-ir", "runtime-value"]))
emit "Host read request valid = " ++ text(runtime["kernel_validate_request"](["filesystem.read", "FS_READ", 4096]))
emit "Module dependency list valid = " ++ text(runtime["library_validate_dependencies"]([["reaper.modules", 1, 0], ["reaper.resources", 1, 0]]))
