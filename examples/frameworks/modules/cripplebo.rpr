# Reaper framework metadata and source-level helper functions.
# Operation contracts: language/frameworks.v1.json

export make framework_id := "cripplebo"
export make display_name := "CrippleBO"
export make feature_key := "RPR-FWK-017"
export make operation_keys := ["RPR-FWK-017-F01", "RPR-FWK-017-F02", "RPR-FWK-017-F03", "RPR-FWK-017-F04", "RPR-FWK-017-F05", "RPR-FWK-017-F06"]
export make maturity := "contract-only"
export make native_registry := "reaper.framework-cabi.v1"

export craft operation_key(index) {
    yield operation_keys[index]
}

export craft framework_manifest() {
    yield [framework_id, display_name, feature_key, operation_keys, maturity]
}
