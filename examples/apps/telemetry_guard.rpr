# Reaper application front-end: telemetry_guard.
make input_path := ask("JSON input path: ")
make payload := read_json(input_path)
make result := app_run("telemetry_guard", payload)
make output_path := ask("JSON output path: ")
make saved := write_json(output_path, result)
emit "Saved telemetry_guard: " ++ saved
