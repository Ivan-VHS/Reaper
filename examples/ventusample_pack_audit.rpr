# Read-only VentuSample pack audit.
# Run from Reaper with two exported VentuSample folders available.
#
# Optional native metric cross-check:
# pass an explicit absolute path to a trusted Pytyliki ABI v1 library as the
# third argument to ventusample_compare. The default uses Reaper's Python core.

make reference := read_json("packs/reference/ventusample_manifest.json")
make candidate := read_json("packs/candidate/ventusample_manifest.json")
make reference_metrics := ventusample_metrics(reference)
make candidate_metrics := ventusample_metrics(candidate)
make report := ventusample_compare(reference, candidate)

emit "Report: " ++ report["schema"]
emit "Distance backend: " ++ report["distance_backend"]
emit "Reference BPM: " ++ text(report["reference"]["bpm"])
emit "Candidate BPM: " ++ text(report["candidate"]["bpm"])
emit "Reference average peak: " ++ text(reference_metrics["mean_peak"])
emit "Candidate average peak: " ++ text(candidate_metrics["mean_peak"])
emit "Metadata/measurement distance: " ++ text(report["euclidean_distance"])

when report["same_style"] {
    emit "Both packs use the same style profile"
} otherwise {
    emit "Style profiles differ; inspect both metadata records"
}

write_json("ventusample-comparison-report.json", report)
