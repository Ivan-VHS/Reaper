# Quantity is cardinality, not the visual length or arrangement of a row.

craft same_quantity(left, right) {
    yield size(left) == size(right)
}

craft count_objects(values) {
    yield size(values)
}

craft balanced(shares) {
    when size(shares) == 0 {
        yield false
    }
    make ordered := sorted(shares)
    yield first(reverse(ordered)) - first(ordered) <= 1
}

craft distribution_valid(total, group_count) {
    when total < 0 {
        yield false
    }
    when group_count < 1 {
        yield false
    }
    make shares := distribute(total, group_count)
    yield size(shares) == group_count and sum(shares) == total and balanced(shares)
}

craft makes_number(left, right, target) {
    when left < 0 or right < 0 or target < 0 {
        yield false
    }
    yield left + right == target
}

make row := [1, 2, 3, 4, 5]
make scattered := [5, 3, 1, 4, 2]
assert(same_quantity(row, scattered), "permutation preserves cardinality")

make toys := ["bear", "hare", "fox", "cat", "dog"]
make piles := partition(toys, 3)
make pile_sizes := map(piles, count_objects)
assert(size(piles) == 3, "partition has three groups")
assert(size(flatten(piles)) == size(toys), "partition conserves every item")
assert(balanced(pile_sizes), "partition sizes differ by at most one")

make shares := distribute(10, 3)
assert(shares == [4, 3, 3], "distribution conserves ten objects")
assert(distribution_valid(12, 3), "twelve objects divide evenly among three groups")
assert(distribution_valid(-1, 3) == false, "a negative object count is invalid")

make bonds_to_five := [[1, 4], [2, 3], [3, 2], [4, 1]]
assert(makes_number(-1, 1, 0) == false, "number parts cannot be negative")

each bond in bonds_to_five {
    assert(makes_number(bond[0], bond[1], 5), "both parts compose five")
}

make bonds_to_ten := [[1, 9], [2, 8], [3, 7], [4, 6], [5, 5]]
each bond in bonds_to_ten {
    assert(makes_number(bond[0], bond[1], 10), "both parts compose ten")
}

emit "EARLY_MATH_INVARIANTS:PASS"
