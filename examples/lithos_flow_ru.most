# МОСТ / LITHOS::FLOW — исполняемый русский пример
# Русские ключевые слова сводятся к каноническим токенам Reaper.
# Предметные слова ниже — обычные имена, а не скрытые встроенные команды.

функция ограничить(значение, минимум, максимум) {
    если значение < минимум { вернуть минимум }
    если значение > максимум { вернуть максимум }
    вернуть значение
}

функция усилить_опору(целостность, давление) {
    вернуть ограничить(целостность + давление * 0.15, 0, 1)
}

функция приглушить_шум(шум) {
    вернуть ограничить(шум * 0.60, 0, 1)
}

функция фильтровать_сигнал(подлинность, накрутка) {
    вернуть подлинность и не накрутка
}

функция среднее(значения) {
    переменная сумма := 0
    переменная количество := 0
    каждый элемент среди значения {
        присвоить сумма := сумма + элемент
        присвоить количество := количество + 1
    }
    если количество == 0 { вернуть 0 }
    вернуть сумма / количество
}

объявить исходная_целостность := 0.40
объявить давление := 0.80
объявить целостность := усилить_опору(исходная_целостность, давление)
объявить исходный_шум := 0.75
объявить ослабленный_шум := приглушить_шум(исходный_шум)
объявить связность := среднее([0.2, 0.4, 0.6])
объявить сигнал_допущен := фильтровать_сигнал(верно, неверно)
объявить отсутствие_оценки := пусто

assert(целостность > 0.519 и целостность < 0.521)
assert(ослабленный_шум > 0.449 и ослабленный_шум < 0.451)
assert(связность > 0.399 и связность < 0.401)
assert(сигнал_допущен)
assert(сигнал_допущен либо неверно)
assert(отсутствие_оценки == ничего)

переменная шаг := 0
повторять пока шаг < 3 {
    присвоить шаг := шаг + 1
}

когда шаг == 3 {
    показать "MOST_LITHOS_RU_OK"
} иначе {
    показать "MOST_LITHOS_RU_FAIL"
}
