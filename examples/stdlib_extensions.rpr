# Collection pipelines and metric standard-library additions.

craft is_even(value) {
    yield value % 2 == 0
}

craft parity(value) {
    yield value % 2
}

craft add(total, value) {
    yield total + value
}

make values := [7, 2, 5, 4, 3, 6]
make even_total := values :: filter(is_even) :: reduce(0, add)
emit "even total = " ++ text(even_total)

emit "descending = " ++ text(sorted(values, "desc"))
emit "stable parity sort = " ++ text(sort_by(values, parity, "asc"))
emit "chunks = " ++ text(chunk(values, 2))

make words := "  Reaper | Studio | Runtime  " :: trim() :: split("|") :: map(trim) :: map(upper)
emit words :: join(" / ")

emit "L1 norm = " ++ text(vector_norm([3, 4], "l1"))
emit "unit vector = " ++ text(vector_normalize([3, 4]))
emit "Manhattan = " ++ text(manhattan_distance([3, 4], [0, 0]))
emit "cosine = " ++ text(cosine_similarity([1, 0], [1, 1]))
emit "projection = " ++ text(vector_projection([3, 4], [1, 0]))
emit "centroid = " ++ text(vector_centroid([[0, 2], [2, 4], [4, 6]]))
