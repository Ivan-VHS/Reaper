# Scanner findings: [path, one_based_line, detector, redacted_value].
# Detection is deliberately conservative and text-based; it is not a regex engine.
craft secret_kind(line) {
    make normalized := lower(line)
    when contains(normalized, "begin private key") {
        yield "private_key_block"
    }
    when starts_with(trim(line), "AKIA") and size(trim(line)) >= 20 {
        yield "aws_access_key_candidate"
    }
    when contains(normalized, "password=") or contains(normalized, "password =") {
        yield "password_assignment"
    }
    when contains(normalized, "token=") or contains(normalized, "token =") {
        yield "token_assignment"
    }
    yield ""
}

craft scan_text(path, content) {
    make lines := split(content, "\n")
    vary findings := []
    vary line_number := 0
    each line in lines {
        change line_number := line_number + 1
        make detector := secret_kind(line)
        when detector != "" {
            change findings := push(findings, [path, line_number, detector, "[redacted]"])
        }
    }
    yield findings
}

craft scan_file(path) {
    make handle := file_open(path, "r")
    make content := file_read(handle)
    file_close(handle)
    yield scan_text(path, content)
}

make sample := "APP_MODE=demo\nPASSWORD=placeholder-value\n# BEGIN PRIVATE KEY"
make findings := scan_text("sample.env", sample)
emit findings
