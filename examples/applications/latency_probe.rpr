# Percentiles use the nearest-rank definition on a sorted non-empty sample.
craft non_negative(value) {
    yield value >= 0
}

craft quantile(sorted_samples, percentile) {
    make rank := ((size(sorted_samples) * percentile) + 99) // 100
    vary index := rank - 1
    when index < 0 {
        change index := 0
    }
    when index >= size(sorted_samples) {
        change index := size(sorted_samples) - 1
    }
    yield sorted_samples[index]
}

craft summarize_latency(samples) {
    make valid := samples :: keep(non_negative) :: sorted()
    when size(valid) == 0 {
        yield ["error", "empty_samples"]
    }
    yield [
        "ok",
        size(valid),
        quantile(valid, 50),
        quantile(valid, 95),
        quantile(valid, 99),
        valid[size(valid) - 1]
    ]
}

make measurements := [18, 42, 10, 20, 35, 27, -1, 51]
emit summarize_latency(measurements)
