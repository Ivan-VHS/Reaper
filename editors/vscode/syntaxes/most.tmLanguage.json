{
  "scopeName": "source.most",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.most",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.most",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.most",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.most",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.most",
          "match": "\\b(make|vary|change|craft|yield|emit|when|otherwise|each|in|loop|while|true|false|nothing|and|or|not|module|import|as|pub|export|fn|struct|enum|trait|impl|type|const|let|mut|return|if|else|match|region|raw|arena|signal|async|await|test|comptime|requires|ensures|unsafe|extern|drop|where|for|break|continue|defer|пусть|переменная|изменить|функция|вернуть|вывести|если|иначе|для|в|цикл|пока|истина|ложь|ничего|и|или|не|импорт|экспорт|как|модуль|публичный|процедура|структура|перечисление|типаж|реализация|тип|константа|связать|изменяемый|возврат|условие|альтернатива|выбор|область|сырой|арена|сигнал|асинхронно|ожидать|тест|вычислить_при_сборке|требует|гарантирует|небезопасно|внешний|где|уничтожить|для_каждого|прервать|продолжить|отложить)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.most",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|string|unit|option|result)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.most",
          "match": "(::|\\?\\?|:=|==|!=|<=|>=|&&|\\|\\||->|[+*/%=<>!.,:-])"
        }
      ]
    }
  }
}
