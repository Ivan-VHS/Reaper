{
  "scopeName": "source.most",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.most",
          "match": "//.*$"
        },
        {
          "name": "comment.block.most",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.most",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.most",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.most",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.most",
          "match": "\\b(module|import|fn|struct|enum|trait|impl|region|raw|arena|signal|async|await|match|test|comptime|requires|ensures|let|mut|if|else|while|for|return|break|continue|unsafe)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.most",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|string|unit|option|result)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.most",
          "match": "(::|\\?\\?|\\+%|\\+\\||->|:=|==|!=|<=|>=|&&|\\|\\||[+*/%=<>!-])"
        }
      ]
    }
  }
}
