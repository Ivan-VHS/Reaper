{
  "name": "reaper-most-language",
  "displayName": "REAPER / MOST Language Support",
  "description": "Syntax highlighting and editor configuration for the Reaper 0.2 / МОСТ language.",
  "version": "0.2.0",
  "publisher": "reaper-project",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "most",
        "aliases": [
          "MOST",
          "most"
        ],
        "extensions": [
          ".most",
          ".rpr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "most",
        "scopeName": "source.most",
        "path": "./syntaxes/most.tmLanguage.json"
      }
    ]
  }
}
