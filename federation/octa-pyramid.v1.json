{
  "schema": "octa.federation-pyramid.v1",
  "topology_id": "octa-8",
  "shape": {
    "kind": "octagonal-pyramid",
    "base_sides": 8,
    "triangular_facets": 8,
    "apex_vertex": "octa-hub"
  },
  "apex": {
    "id": "octa-hub",
    "role": "protocol-coordination-only",
    "executable": false,
    "single_point_of_failure": false,
    "linked_facets": [
      "facet.identity",
      "facet.contracts",
      "facet.transport",
      "facet.provenance",
      "facet.validation",
      "facet.privacy",
      "facet.safety",
      "facet.audit"
    ]
  },
  "base_mesh": {
    "mode": "horizontal-complete-directed-peer-mesh",
    "project_ids": [
      "reaper",
      "pytyliki",
      "oplague"
    ],
    "directed_peer_links": 6,
    "self_loops": 3
  },
  "facets": [
    {
      "id": "facet.identity",
      "side": 1,
      "name": "Identity and namespaces",
      "invariant": "Stable project/interface IDs; opaque person and device references."
    },
    {
      "id": "facet.contracts",
      "side": 2,
      "name": "Contracts and versioning",
      "invariant": "Explicit versioned contracts; breaking changes require a new version."
    },
    {
      "id": "facet.transport",
      "side": 3,
      "name": "Transport and bounded envelopes",
      "invariant": "Bounded JSON files or synchronous ABI calls; reject malformed and oversized input."
    },
    {
      "id": "facet.provenance",
      "side": 4,
      "name": "Provenance and integrity",
      "invariant": "Preserve source digests and artifact lineage; hashes do not authenticate publishers."
    },
    {
      "id": "facet.validation",
      "side": 5,
      "name": "Validation and normalization",
      "invariant": "Validate dimensions, units, ranges and finite numbers before comparison."
    },
    {
      "id": "facet.privacy",
      "side": 6,
      "name": "Privacy and consent",
      "invariant": "Pseudonymize device references; keep native loading and exports explicit."
    },
    {
      "id": "facet.safety",
      "side": 7,
      "name": "Execution and safety boundaries",
      "invariant": "Read-only hardware workflows; no installation or privileged control."
    },
    {
      "id": "facet.audit",
      "side": 8,
      "name": "Audit and reproducibility",
      "invariant": "Deterministic fingerprints, inspectable results and discrepancy states."
    }
  ],
  "peer_links": [
    {
      "id": "reaper-to-oplage",
      "from": "reaper",
      "to": "oplague",
      "transport": "json-file",
      "interface": "reaper.oplage-comparison.v1",
      "flow": "artifact",
      "status": "implemented"
    },
    {
      "id": "oplague-to-reaper",
      "from": "oplague",
      "to": "reaper",
      "transport": "json-file",
      "interface": "oplage.device-snapshot.v1",
      "flow": "artifact",
      "status": "implemented"
    },
    {
      "id": "reaper-to-pytyliki",
      "from": "reaper",
      "to": "pytyliki",
      "transport": "native-ffi",
      "interface": "pytyliki.c-abi.v1",
      "flow": "request",
      "status": "implemented"
    },
    {
      "id": "pytyliki-to-reaper",
      "from": "pytyliki",
      "to": "reaper",
      "transport": "native-ffi",
      "interface": "pytyliki.c-abi.v1",
      "flow": "response",
      "status": "implemented"
    },
    {
      "id": "oplague-to-pytyliki",
      "from": "oplague",
      "to": "pytyliki",
      "transport": "native-ffi",
      "interface": "pytyliki.c-abi.v1",
      "flow": "request",
      "status": "implemented"
    },
    {
      "id": "pytyliki-to-oplage",
      "from": "pytyliki",
      "to": "oplague",
      "transport": "native-ffi",
      "interface": "pytyliki.c-abi.v1",
      "flow": "response",
      "status": "implemented"
    }
  ],
  "self_loops": [
    {
      "project": "reaper",
      "contract": "reaper.internal-runtime.v1",
      "surface": "language frontend, modules, IR/VM, resources and audit"
    },
    {
      "project": "pytyliki",
      "contract": "pytyliki.internal-core.v1",
      "surface": "C11 processor, memory, DSP, metrics and TRACE"
    },
    {
      "project": "oplague",
      "contract": "oplage.internal-workbench.v1",
      "surface": "PnP inventory, package inspection, driver evidence and reports"
    }
  ],
  "semantics": {
    "complete_pairwise_product": true,
    "directed_link_count_formula": "n*(n-1)",
    "hub_is_not_a_runtime_gateway": true,
    "request_response_edges_are_synchronous": true,
    "no_implicit_native_loading": true,
    "no_driver_mutation_through_mesh": true
  }
}
