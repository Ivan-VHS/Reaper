{
  "schema": "octa.federation-pyramid.v1",
  "topology_id": "octa-8",
  "shape": {
    "kind": "octagonal-pyramid",
    "base_sides": 8,
    "triangular_facets": 8,
    "apex_vertex": "octa-hub"
  },
  "apex": {
    "id": "octa-hub",
    "role": "protocol-coordination-only",
    "executable": false,
    "single_point_of_failure": false,
    "linked_facets": [
      "facet.identity",
      "facet.contracts",
      "facet.transport",
      "facet.provenance",
      "facet.validation",
      "facet.privacy",
      "facet.safety",
      "facet.audit"
    ]
  },
  "base_mesh": {
    "mode": "horizontal-complete-directed-peer-mesh",
    "project_ids": [
      "reaper",
      "pytyliki",
      "oplague",
      "ventusample"
    ],
    "directed_peer_links": 12,
    "self_loops": 4
  },
  "facets": [
    {
      "id": "facet.identity",
      "side": 1,
      "name": "Identity and namespaces",
      "invariant": "Stable project and interface identifiers; no personal or host identity is required in interchange."
    },
    {
      "id": "facet.contracts",
      "side": 2,
      "name": "Contracts and versioning",
      "invariant": "Explicit schemas and ABI versions; breaking changes require a new version."
    },
    {
      "id": "facet.transport",
      "side": 3,
      "name": "Transport and bounded envelopes",
      "invariant": "Bounded JSON artifacts or synchronous ABI calls; malformed and oversized input is rejected."
    },
    {
      "id": "facet.provenance",
      "side": 4,
      "name": "Provenance and integrity",
      "invariant": "Preserve source digests and artifact lineage; hashes identify bytes, not publishers."
    },
    {
      "id": "facet.validation",
      "side": 5,
      "name": "Validation and normalization",
      "invariant": "Validate dimensions, units, ranges, formats and finite values before comparison."
    },
    {
      "id": "facet.privacy",
      "side": 6,
      "name": "Privacy and consent",
      "invariant": "Keep exports and native loading explicit; minimize device identifiers and local paths."
    },
    {
      "id": "facet.safety",
      "side": 7,
      "name": "Execution and safety boundaries",
      "invariant": "Safe local workflows; no privileged hardware mutation through the mesh."
    },
    {
      "id": "facet.audit",
      "side": 8,
      "name": "Audit and reproducibility",
      "invariant": "Deterministic outputs, inspectable manifests and discrepancy states."
    }
  ],
  "peer_links": [
