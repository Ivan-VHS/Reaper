# Stage-0 frontend code: this tokenizer is written in Reaper itself.
# The bootstrap slice supports ASCII and explicit Unicode script ranges.
# Full Unicode XID conformance remains tracked in docs/SELF_HOSTING_BOOTSTRAP.md.

craft is_ascii_letter(char) {
    yield (char >= "a" and char <= "z") or (char >= "A" and char <= "Z")
}

craft is_unicode_letter(char) {
    yield (char >= "À" and char <= "Ö") or (char >= "Ø" and char <= "ö") or (char >= "ø" and char <= "ÿ") or (char >= "Ā" and char <= "ʯ") or (char >= "Ά" and char <= "Ϋ") or (char >= "α" and char <= "ϋ") or (char >= "ϐ" and char <= "Ͽ") or (char >= "Ѐ" and char <= "ӿ") or (char >= "Ա" and char <= "Ֆ") or (char >= "ա" and char <= "և") or (char >= "א" and char <= "ת") or (char >= "ء" and char <= "ي") or (char >= "ہ" and char <= "ے") or (char >= "अ" and char <= "ह") or (char >= "क़" and char <= "ॡ") or (char >= "あ" and char <= "ゖ") or (char >= "ァ" and char <= "ヺ") or (char >= "㐀" and char <= "䶿") or (char >= "一" and char <= "鿿") or (char >= "가" and char <= "힣")
}

craft is_combining_mark(char) {
    yield (char >= "̀" and char <= "ͯ") or (char >= "᪰" and char <= "᫿") or (char >= "᷀" and char <= "᷿") or (char >= "⃐" and char <= "⃿") or (char >= "︠" and char <= "︯")
}

craft is_identifier_start(char) {
    yield is_ascii_letter(char) or is_unicode_letter(char) or char == "_"
}

craft is_identifier_continue(char) {
    yield is_identifier_start(char) or is_ascii_digit(char) or is_combining_mark(char)
}

craft is_ascii_digit(char) {
    yield char >= "0" and char <= "9"
}

craft keyword_kind(word) {
    when word == "make" or word == "пусть" { yield "MAKE" }
    when word == "vary" or word == "переменная" { yield "VARY" }
    when word == "change" or word == "изменить" { yield "CHANGE" }
    when word == "craft" or word == "функция" { yield "CRAFT" }
    when word == "yield" or word == "вернуть" { yield "YIELD" }
    when word == "emit" or word == "вывести" { yield "EMIT" }
    when word == "when" or word == "если" { yield "WHEN" }
    when word == "otherwise" or word == "иначе" { yield "OTHERWISE" }
    when word == "each" or word == "для" { yield "EACH" }
    when word == "in" or word == "в" { yield "IN" }
    when word == "loop" or word == "цикл" { yield "LOOP" }
    when word == "while" or word == "пока" { yield "WHILE" }
    when word == "true" or word == "истина" { yield "TRUE" }
    when word == "false" or word == "ложь" { yield "FALSE" }
    when word == "nothing" or word == "ничего" { yield "NOTHING" }
    when word == "and" or word == "и" { yield "AND" }
    when word == "or" or word == "или" { yield "OR" }
    when word == "not" or word == "не" { yield "NOT" }
    when word == "import" or word == "импорт" { yield "IMPORT" }
    when word == "export" or word == "экспорт" { yield "EXPORT" }
    when word == "as" or word == "как" { yield "AS" }
    yield "IDENT"
}

craft tokenize(source) {
    vary index := 0
    vary line := 1
    vary column := 1
    vary tokens := []
    vary failed := false
    make source_length := size(source)

    craft current(offset) {
        when index + offset < source_length {
            yield source[index + offset]
        }
        yield ""
    }

    craft advance() {
        make char := current(0)
        change index := index + 1
        when char == "\n" {
            change line := line + 1
            change column := 1
        } otherwise {
            change column := column + 1
        }
        yield char
    }

    craft skip_comment() {
        make ignored_hash := advance()
        loop while index < source_length and current(0) != "\n" {
            make ignored_char := advance()
        }
    }

    craft scan_string(start_line, start_column) {
        make ignored_open := advance()
        vary value := ""

        loop while index < source_length and current(0) != "\"" {
            make char := advance()
            when char == "\n" {
                yield ["ERROR", "string literal cannot span lines", start_line, start_column]
            } otherwise {
                when char == "\\" {
                    when index >= source_length {
                        yield ["ERROR", "unterminated string escape", start_line, start_column]
                    } otherwise {
                        make escaped := advance()
                        when escaped == "n" { change value := value ++ "\n" } otherwise {
                            when escaped == "r" { change value := value ++ "\r" } otherwise {
                                when escaped == "t" { change value := value ++ "\t" } otherwise {
                                    when escaped == "\"" { change value := value ++ "\"" } otherwise {
                                        when escaped == "\\" { change value := value ++ "\\" } otherwise {
                                            yield ["ERROR", "unknown escape sequence \\" ++ escaped, start_line, start_column]
                                        }
                                    }
                                }
                            }
                        }
                    }
                } otherwise {
                    change value := value ++ char
                }
            }
        }

        when index >= source_length {
            yield ["ERROR", "unterminated string literal", start_line, start_column]
        }
        make ignored_close := advance()
        yield ["STRING", value, start_line, start_column]
    }

    craft scan_number(start_line, start_column) {
        vary value := ""
        loop while index < source_length and is_ascii_digit(current(0)) {
            change value := value ++ advance()
        }
        when current(0) == "." and is_ascii_digit(current(1)) {
            change value := value ++ advance()
            loop while index < source_length and is_ascii_digit(current(0)) {
                change value := value ++ advance()
            }
        }
        yield ["NUMBER", value, start_line, start_column]
    }

    craft scan_identifier(start_line, start_column) {
        vary value := ""
        loop while index < source_length and is_identifier_continue(current(0)) {
            change value := value ++ advance()
        }
        yield [keyword_kind(value), value, start_line, start_column]
    }

    craft scan_operator(start_line, start_column) {
        make triplet := current(0) ++ current(1) ++ current(2)
        when token_is_reserved(triplet) {
            make ignored_first := advance()
            make ignored_second := advance()
            make ignored_third := advance()
            yield ["CATALOG_OPERATOR", triplet, start_line, start_column]
        } otherwise {
            make pair := current(0) ++ current(1)
            when pair == ":=" or pair == "==" or pair == "!=" or pair == "<=" or pair == ">=" or pair == "//" or pair == "**" or pair == "++" or pair == "::" {
                make ignored_first := advance()
                make ignored_second := advance()
                yield [pair, pair, start_line, start_column]
            } otherwise {
                make char := current(0)
                when char == "+" or char == "-" or char == "*" or char == "/" or char == "%" or char == "<" or char == ">" or char == "(" or char == ")" or char == "{" or char == "}" or char == "[" or char == "]" or char == "," or char == "=" {
                    make ignored := advance()
                    yield [char, char, start_line, start_column]
                } otherwise {
                    make ignored := advance()
                    yield ["ERROR", "unexpected character " ++ char, start_line, start_column]
                }
            }
        }
    }

    loop while index < source_length and not failed {
        make char := current(0)
        when char == " " or char == "\t" or char == "\r" {
            make ignored := advance()
        } otherwise {
            when char == "\n" {
                change tokens := push(tokens, ["NEWLINE", "\n", line, column])
                make ignored := advance()
            } otherwise {
                when char == "#" {
                    skip_comment()
                } otherwise {
                    make start_line := line
                    make start_column := column
                    vary item := ["", "", start_line, start_column]

                    when char == "\"" {
                        change item := scan_string(start_line, start_column)
                    } otherwise {
                        when is_ascii_digit(char) {
                            change item := scan_number(start_line, start_column)
                        } otherwise {
                            when is_identifier_start(char) {
                                change item := scan_identifier(start_line, start_column)
                            } otherwise {
                                change item := scan_operator(start_line, start_column)
                            }
                        }
                    }

                    change tokens := push(tokens, item)
                    when item[0] == "ERROR" {
                        change failed := true
                    }
                }
            }
        }
    }

    when not failed {
        change tokens := push(tokens, ["EOF", "", line, column])
    }
    yield tokens
}

# These assertions execute the Reaper-written tokenizer during Python bootstrap CI.
make sample := "make x := 12.5\nemit \"ok\" # ignored\n"
make expected := [
    ["MAKE", "make", 1, 1],
    ["IDENT", "x", 1, 6],
    [":=", ":=", 1, 8],
    ["NUMBER", "12.5", 1, 11],
    ["NEWLINE", "\n", 1, 15],
    ["EMIT", "emit", 2, 1],
    ["STRING", "ok", 2, 6],
    ["NEWLINE", "\n", 2, 20],
    ["EOF", "", 3, 1]
]
assert(tokenize(sample) == expected, "stage-0 token and source-position mismatch")

make escaped := tokenize("emit \"line\\nnext\"")
assert(escaped == [
    ["EMIT", "emit", 1, 1],
    ["STRING", "line\nnext", 1, 6],
    ["EOF", "", 1, 18]
], "string escape decoding mismatch")

make invalid := tokenize("emit @")
assert(invalid == [
    ["EMIT", "emit", 1, 1],
    ["ERROR", "unexpected character @", 1, 6]
], "invalid-character diagnostic mismatch")



make pipeline := tokenize("emit value :: transform")
assert(pipeline == [
    ["EMIT", "emit", 1, 1],
    ["IDENT", "value", 1, 6],
    ["::", "::", 1, 12],
    ["IDENT", "transform", 1, 15],
    ["EOF", "", 1, 24]
], "pipeline operator tokenization mismatch")


make unicode_tokens := tokenize("emit α 名 \"x\"")
assert(unicode_tokens[1] == ["IDENT", "α", 1, 6], "Greek identifier recognition mismatch")
assert(unicode_tokens[2] == ["IDENT", "名", 1, 8], "CJK identifier recognition mismatch")

make combining_tokens := tokenize("emit á")
assert(combining_tokens[1] == ["IDENT", "á", 1, 6], "combining marks must continue identifiers")

make cyrillic_tokens := tokenize("emit Привет_мир42")
assert(cyrillic_tokens[1] == ["IDENT", "Привет_мир42", 1, 6], "Cyrillic letters, underscore and digits must continue identifiers")
assert(cyrillic_tokens[size(cyrillic_tokens) - 1][0] == "EOF", "Unicode identifier scan must make progress and reach EOF")


make russian_keyword_tokens := tokenize("пусть x := 1")
assert(russian_keyword_tokens[0] == ["MAKE", "пусть", 1, 1], "Russian keyword alias mismatch")
assert(russian_keyword_tokens[1] == ["IDENT", "x", 1, 7], "Russian keyword identifier position mismatch")

make module_tokens := tokenize("import \"math.rpr\" as math")
assert(module_tokens[0] == ["IMPORT", "import", 1, 1], "import keyword mismatch")
assert(module_tokens[2] == ["AS", "as", 1, 19], "as keyword mismatch")

emit "SELFHOST_LEXER_OK"
