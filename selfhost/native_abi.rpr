# Aggregate ABI classification v1.
# Supported classes are bounded: no vectors, x87, variadic register-save
# areas, language-specific exceptions or final register spills.
import "type_platform.rpr"

export craft abi_error(code, message) {
    yield [false, code, message]
}

export craft abi_shape(eightbyte_classes, hfa_element, hfa_count, has_unaligned_field) {
    yield ["ABI_SHAPE_V1", eightbyte_classes, hfa_element, hfa_count, has_unaligned_field]
}

export craft abi_classify_sysv(size_bytes, shape, purpose) {
    when size_bytes < 1 or size_bytes > 9223372036854775807 {
        yield abi_error("RPR-ABI-0001", "aggregate size must be positive and representable")
    }
    when size(shape) != 5 or shape[0] != "ABI_SHAPE_V1" or (purpose != "argument" and purpose != "return") {
        yield abi_error("RPR-ABI-0002", "ABI shape or classification purpose is invalid")
    }
    when size_bytes > 16 or shape[4] == true {
        yield [true, ["MEMORY"], "indirect", "stack", purpose == "return", ""]
    }
    make expected_eightbytes := (size_bytes + 7) // 8
    when size(shape[1]) != expected_eightbytes {
        yield abi_error("RPR-ABI-0003", "SysV aggregate needs one class per occupied eightbyte")
    }
    vary classes := []
    each value in shape[1] {
        when value != "INTEGER" and value != "SSE" {
            yield abi_error("RPR-ABI-0004", "SysV v1 accepts INTEGER and SSE classes only")
        }
        change classes := push(classes, value)
    }
    yield [true, classes, "direct", "gpr_or_sse", false, ""]
}

export craft abi_classify_ms_x64(size_bytes, purpose) {
    when purpose != "argument" and purpose != "return" {
        yield abi_error("RPR-ABI-0005", "classification purpose must be argument or return")
    }
    when size_bytes == 1 or size_bytes == 2 or size_bytes == 4 or size_bytes == 8 {
        yield [true, ["INTEGER"], "direct", "gpr", false, ""]
    }
    yield [true, ["INDIRECT"], "indirect", "caller_storage", purpose == "return", ""]
}

export craft abi_classify_aapcs64(size_bytes, shape, purpose) {
    when size_bytes < 1 or size_bytes > 9223372036854775807 or size(shape) != 5 or shape[0] != "ABI_SHAPE_V1" {
        yield abi_error("RPR-ABI-0006", "AAPCS64 aggregate size or shape is invalid")
    }
    when purpose != "argument" and purpose != "return" {
        yield abi_error("RPR-ABI-0007", "classification purpose must be argument or return")
    }
    when shape[2] == "f32" or shape[2] == "f64" {
        when shape[3] >= 1 and shape[3] <= 4 {
            when (shape[2] == "f32" and size_bytes == shape[3] * 4) or (shape[2] == "f64" and size_bytes == shape[3] * 8) {
                yield [true, ["HFA", shape[2], shape[3]], "direct", "v_registers", false, ""]
            }
        }
    }
    when size_bytes <= 16 and shape[4] != true {
        vary count := 1
        when size_bytes > 8 { change count := 2 }
        yield [true, ["INTEGER", count], "direct", "x_registers", false, ""]
    }
    yield [true, ["INDIRECT"], "indirect", "caller_storage", purpose == "return", ""]
}

export craft native_abi_classify(platform, layout, shape, purpose) {
    make checked := platform_validate(platform)
    when not checked[0] { yield checked }
    when not platform_process_abi_declared(platform) {
        yield abi_error("RPR-ABI-0008", "platform process ABI is not finalized")
    }
    when size(layout) != 3 or layout[0] < 1 or layout[1] < 1 {
        yield abi_error("RPR-ABI-0009", "aggregate layout must contain positive size and alignment")
    }

    vary classification := []
    when platform[9] == "SYSV_X86_64" {
        change classification := abi_classify_sysv(layout[0], shape, purpose)
    } otherwise {
        when platform[9] == "MS_X64" {
            change classification := abi_classify_ms_x64(layout[0], purpose)
        } otherwise {
            when platform[9] == "AAPCS64" {
                change classification := abi_classify_aapcs64(layout[0], shape, purpose)
            } otherwise {
                yield abi_error("RPR-ABI-0010", "no aggregate classifier is registered for process ABI: " ++ platform[9])
            }
        }
    }
    when not classification[0] { yield classification }
    yield [true, [
        "ABI_PLAN_V1", platform[1], platform[9], purpose,
        classification[2], classification[1], classification[3],
        classification[4], "classified_not_lowered"
    ], ""]
}

export craft native_abi_classify_signature(platform, arguments, result_layout, result_shape) {
    vary argument_plans := []
    each argument in arguments {
        when size(argument) != 4 or argument[0] != "ABI_ARGUMENT_V1" {
            yield abi_error("RPR-ABI-0011", "function argument descriptor is malformed")
        }
        make planned := native_abi_classify(platform, argument[2], argument[3], "argument")
        when not planned[0] { yield planned }
        change argument_plans := push(argument_plans, [argument[1], planned[1]])
    }
    make result_plan := native_abi_classify(platform, result_layout, result_shape, "return")
    when not result_plan[0] { yield result_plan }
    yield [true, ["ABI_SIGNATURE_V1", platform[1], platform[9], argument_plans, result_plan[1], "register_allocation_pending"], ""]
}
