import "native_abi.rpr"
import "type_platform.rpr"

make sysv := platform_linux_x86_64()
make direct_sysv := native_abi_classify(sysv, [16, 8, []], abi_shape(["INTEGER", "SSE"], "", 0, false), "return")
assert(direct_sysv[0] and direct_sysv[1][4] == "direct" and direct_sysv[1][5][0] == "INTEGER", "SysV small aggregate must receive per-eightbyte classification")
make lowered_sysv := native_abi_lower_aggregate(sysv, direct_sysv[1], [16, 8, []])
assert(lowered_sysv[0] and lowered_sysv[1][5][0][2] == 0 and lowered_sysv[1][5][1][2] == 8, "SysV aggregate lowering must expose ordered eightbyte pieces")
make large_sysv := native_abi_classify(sysv, [24, 8, []], abi_shape([], "", 0, false), "return")
assert(large_sysv[0] and large_sysv[1][4] == "indirect" and large_sysv[1][7] == true, "SysV large result must use sret")
make lowered_large := native_abi_lower_aggregate(sysv, large_sysv[1], [24, 8, []])
assert(lowered_large[0] and lowered_large[1][5][0][1] == "INDIRECT_POINTER" and lowered_large[1][6] == true, "SysV indirect aggregate return must lower to a hidden result pointer")
make windows := platform_windows_x86_64()
make direct_ms := native_abi_classify(windows, [8, 8, []], abi_shape([], "", 0, false), "argument")
assert(direct_ms[0] and direct_ms[1][4] == "direct", "Microsoft x64 8-byte aggregate must pass directly")
make indirect_ms := native_abi_classify(windows, [12, 4, []], abi_shape([], "", 0, false), "return")
assert(indirect_ms[0] and indirect_ms[1][4] == "indirect" and indirect_ms[1][7] == true, "Microsoft x64 12-byte aggregate return must use caller storage")
make lowered_ms := native_abi_lower_aggregate(windows, indirect_ms[1], [12, 4, []])
assert(lowered_ms[0] and lowered_ms[1][5][0][1] == "INDIRECT_POINTER", "Microsoft x64 indirect aggregate must lower to caller storage pointer")
make arm := platform_linux_aarch64()
make hfa := native_abi_classify(arm, [16, 4, []], abi_shape([], "f32", 4, false), "argument")
assert(hfa[0] and hfa[1][5][0] == "HFA", "AAPCS64 homogeneous float aggregate must use HFA classes")
make lowered_hfa := native_abi_lower_aggregate(arm, hfa[1], [16, 4, []])
assert(lowered_hfa[0] and size(lowered_hfa[1][5]) == 4 and lowered_hfa[1][5][3][2] == 12, "AAPCS64 HFA lowering must preserve homogeneous element offsets")
make profile_only := platform_dak_x86_64()
make rejected := native_abi_classify(profile_only, [8, 8, []], abi_shape(["INTEGER"], "", 0, false), "argument")
assert(not rejected[0] and rejected[1] == "RPR-ABI-0008", "unfinalized target ABI must reject classification")
make bad_slots := native_abi_classify(sysv, [16, 8, []], abi_shape(["INTEGER"], "", 0, false), "argument")
assert(not bad_slots[0] and bad_slots[1] == "RPR-ABI-0003", "SysV class count must match occupied eightbytes")
emit "REAPER_NATIVE_ABI_CLASSIFICATION_OK"
