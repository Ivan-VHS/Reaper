# Reaper-native LSP line and UTF-16 position conversion.
# Reaper string indexes count Unicode scalar values; LSP characters count UTF-16
# code units. A position inside a surrogate pair is rejected as non-scalar.

craft lsp_utf16_units(char) {
    when size(char) == 0 { yield 0 }
    when char > "￿" { yield 2 }
    yield 1
}

craft lsp_line_index(source) {
    vary index := 0
    vary line := 1
    vary entries := [[1, 0]]
    loop while index < size(source) {
        when source[index] == "\r" {
            when index + 1 < size(source) and source[index + 1] == "\n" {
                change index := index + 2
            } otherwise {
                change index := index + 1
            }
            change line := line + 1
            change entries := push(entries, [line, index])
        } otherwise {
            when source[index] == "\n" {
                change index := index + 1
                change line := line + 1
                change entries := push(entries, [line, index])
            } otherwise {
                change index := index + 1
            }
        }
    }
    yield entries
}

craft lsp_line_for_offset(source, line_index, offset) {
    when offset < 0 or offset > size(source) { yield ["ERR", "offset outside source"] }
    vary low := 0
    vary high := size(line_index) - 1
    vary best := 0
    loop while low <= high {
        make middle := low + (high - low) // 2
        when line_index[middle][1] <= offset {
            change best := middle
            change low := middle + 1
        } otherwise {
            change high := middle - 1
        }
    }
    yield ["OK", best]
}

craft lsp_line_content_end(source, line_index, line_slot) {
    make start := line_index[line_slot][1]
    vary finish := size(source)
    when line_slot + 1 < size(line_index) {
        change finish := line_index[line_slot + 1][1]
    }
    when finish > start and source[finish - 1] == "\n" {
        change finish := finish - 1
        when finish > start and source[finish - 1] == "\r" { change finish := finish - 1 }
    } otherwise {
        when finish > start and source[finish - 1] == "\r" { change finish := finish - 1 }
    }
    yield ["OK", [start, finish]]
}

craft lsp_utf16_column(source, start, finish, offset) {
    when start < 0 or finish < start or finish > size(source) or offset < start or offset > finish {
        yield ["ERR", "invalid LSP source range"]
    }
    vary index := start
    vary column := 0
    loop while index < offset {
        change column := column + lsp_utf16_units(source[index])
        change index := index + 1
    }
    yield ["OK", column]
}

craft lsp_offset_to_position(source, line_index, offset) {
    make line_slot := lsp_line_for_offset(source, line_index, offset)
    when line_slot[0] != "OK" { yield line_slot }
    make bounds := lsp_line_content_end(source, line_index, line_slot[1])
    make start := line_index[line_slot[1]][1]
    vary mapped_offset := offset
    when mapped_offset > bounds[1][1] {
        change mapped_offset := bounds[1][1]
    }
    make column := lsp_utf16_column(source, start, bounds[1][1], mapped_offset)
    when column[0] != "OK" { yield column }
    yield ["OK", [line_index[line_slot[1]][0] - 1, column[1]]]
}

craft lsp_position_to_offset(source, line_index, line_number, utf16_column) {
    when line_number < 0 or line_number >= size(line_index) or utf16_column < 0 {
        yield ["ERR", "LSP position outside document"]
    }
    make bounds := lsp_line_content_end(source, line_index, line_number)
    make start := bounds[1][0]
    make finish := bounds[1][1]
    vary index := start
    vary column := 0
    loop while index < finish {
        when column == utf16_column { yield ["OK", index] }
        make width := lsp_utf16_units(source[index])
        when column + width > utf16_column {
            yield ["ERR", "LSP position splits a surrogate pair"]
        }
        change column := column + width
        change index := index + 1
    }
    when column == utf16_column { yield ["OK", finish] }
    yield ["ERR", "LSP character exceeds line length", utf16_column]
}

make source := "a😀b\nz"
make line_index := lsp_line_index(source)
assert(lsp_utf16_units("a") == 1, "BMP character must use one UTF-16 unit")
assert(lsp_utf16_units("😀") == 2, "supplementary character must use two UTF-16 units")
assert(lsp_offset_to_position(source, line_index, 0) == ["OK", [0, 0]], "LSP first position mismatch")
assert(lsp_offset_to_position(source, line_index, 1) == ["OK", [0, 1]], "LSP position before supplementary scalar mismatch")
assert(lsp_offset_to_position(source, line_index, 2) == ["OK", [0, 3]], "LSP position after supplementary scalar mismatch")
assert(lsp_offset_to_position(source, line_index, 3) == ["OK", [0, 4]], "LSP end-of-line position mismatch")
assert(lsp_offset_to_position(source, line_index, 4) == ["OK", [1, 0]], "LSP next-line position mismatch")
assert(lsp_position_to_offset(source, line_index, 0, 0) == ["OK", 0], "LSP reverse first position mismatch")
assert(lsp_position_to_offset(source, line_index, 0, 1) == ["OK", 1], "LSP reverse BMP position mismatch")
assert(lsp_position_to_offset(source, line_index, 0, 2)[0] == "ERR", "surrogate interior position accepted")
assert(lsp_position_to_offset(source, line_index, 0, 3) == ["OK", 2], "LSP reverse supplementary position mismatch")
assert(lsp_position_to_offset(source, line_index, 0, 4) == ["OK", 3], "LSP reverse line-end position mismatch")
assert(lsp_position_to_offset(source, line_index, 1, 0) == ["OK", 4], "LSP reverse next-line position mismatch")
assert(lsp_position_to_offset(source, line_index, 1, 2)[0] == "ERR", "column beyond line accepted")
assert(lsp_offset_to_position(source, line_index, 99)[0] == "ERR", "offset beyond source accepted")

emit "SELFHOST_LSP_POSITIONS_OK"
