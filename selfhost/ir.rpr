# Stage-3 bootstrap slice: canonical expression IR and stack bytecode.
#
# Canonical expression nodes use the versioned RIR1 envelope:
# ["RIR1", tag, payload..., line, column]
# The generated bytecode is a deterministic expression-only stack program.
# It is not a VM, native object writer, or full language compiler.

craft ir_failure(message, line, column) {
    yield ["ERROR", message, line, column]
}

craft known_ir_binary_operator(operator) {
    yield operator == "::" or operator == "OR" or operator == "AND" or operator == "==" or operator == "!=" or operator == "<" or operator == "<=" or operator == ">" or operator == ">=" or operator == "++" or operator == "+" or operator == "-" or operator == "*" or operator == "/" or operator == "//" or operator == "%" or operator == "**"
}

craft lower_expression(node) {
    when size(node) < 3 {
        yield ir_failure("malformed expression node", 1, 1)
    }

    when node[0] == "literal" {
        when size(node) != 5 {
            yield ir_failure("malformed literal node", 1, 1)
        }
        when node[1] != "NUMBER" and node[1] != "STRING" and node[1] != "TRUE" and node[1] != "FALSE" and node[1] != "NOTHING" {
            yield ir_failure("unsupported literal kind: " ++ node[1], node[3], node[4])
        }
        yield ["RIR1", "const", node[1], node[2], node[3], node[4]]
    }

    when node[0] == "name" {
        when size(node) != 4 {
            yield ir_failure("malformed name node", 1, 1)
        }
        yield ["RIR1", "load", node[1], node[2], node[3]]
    }

    when node[0] == "unary" {
        when size(node) != 5 {
            yield ir_failure("malformed unary node", 1, 1)
        }
        when node[1] != "-" and node[1] != "NOT" {
            yield ir_failure("unsupported unary operator: " ++ node[1], node[3], node[4])
        }
        make operand := lower_expression(node[2])
        when operand[0] == "ERROR" { yield operand }
        yield ["RIR1", "unary", node[1], operand, node[3], node[4]]
    }

    when node[0] == "binary" {
        when size(node) != 6 {
            yield ir_failure("malformed binary node", 1, 1)
        }
        when not known_ir_binary_operator(node[1]) {
            yield ir_failure("unsupported binary operator: " ++ node[1], node[4], node[5])
        }
        make left := lower_expression(node[2])
        when left[0] == "ERROR" { yield left }
        make right := lower_expression(node[3])
        when right[0] == "ERROR" { yield right }
        yield ["RIR1", "binary", node[1], left, right, node[4], node[5]]
    }

    when node[0] == "call" {
        when size(node) != 5 {
            yield ir_failure("malformed call node", 1, 1)
        }
        make callee := lower_expression(node[1])
        when callee[0] == "ERROR" { yield callee }
        vary arguments := []
        vary argument_index := 0
        loop while argument_index < size(node[2]) {
            make argument := lower_expression(node[2][argument_index])
            when argument[0] == "ERROR" { yield argument }
            change arguments := push(arguments, argument)
            change argument_index := argument_index + 1
        }
        yield ["RIR1", "call", callee, arguments, node[3], node[4]]
    }

    when node[0] == "list" {
        when size(node) != 4 {
            yield ir_failure("malformed list node", 1, 1)
        }
        vary items := []
        vary item_index := 0
        loop while item_index < size(node[1]) {
            make item := lower_expression(node[1][item_index])
            when item[0] == "ERROR" { yield item }
            change items := push(items, item)
            change item_index := item_index + 1
        }
        yield ["RIR1", "list", items, node[2], node[3]]
    }

    when node[0] == "index" {
        when size(node) != 5 {
            yield ir_failure("malformed index node", 1, 1)
        }
        make collection := lower_expression(node[1])
        when collection[0] == "ERROR" { yield collection }
        make index_expression := lower_expression(node[2])
        when index_expression[0] == "ERROR" { yield index_expression }
        yield ["RIR1", "index", collection, index_expression, node[3], node[4]]
    }

    yield ir_failure("unsupported AST node: " ++ node[0], 1, 1)
}

craft verify_ir(ir) {
    when size(ir) < 4 or ir[0] != "RIR1" {
        yield ir_failure("invalid RIR1 header", 1, 1)
    }
    make kind := ir[1]

    when kind == "const" {
        when size(ir) != 6 {
            yield ir_failure("invalid const shape", 1, 1)
        }
        when ir[2] != "NUMBER" and ir[2] != "STRING" and ir[2] != "TRUE" and ir[2] != "FALSE" and ir[2] != "NOTHING" {
            yield ir_failure("invalid const kind", ir[4], ir[5])
        }
        when ir[4] < 1 or ir[5] < 1 { yield ir_failure("invalid const span", ir[4], ir[5]) }
        yield ["OK"]
    }

    when kind == "load" {
        when size(ir) != 5 or ir[2] == "" {
            yield ir_failure("invalid load shape or name", 1, 1)
        }
        when ir[3] < 1 or ir[4] < 1 { yield ir_failure("invalid load span", ir[3], ir[4]) }
        yield ["OK"]
    }

    when kind == "unary" {
        when size(ir) != 6 { yield ir_failure("invalid unary shape", 1, 1) }
        when ir[2] != "-" and ir[2] != "NOT" { yield ir_failure("invalid unary operator", ir[4], ir[5]) }
        make child := verify_ir(ir[3])
        when child[0] == "ERROR" { yield child }
        when ir[4] < 1 or ir[5] < 1 { yield ir_failure("invalid unary span", ir[4], ir[5]) }
        yield ["OK"]
    }

    when kind == "binary" {
        when size(ir) != 7 { yield ir_failure("invalid binary shape", 1, 1) }
        when not known_ir_binary_operator(ir[2]) { yield ir_failure("invalid binary operator", ir[5], ir[6]) }
        make left := verify_ir(ir[3])
        when left[0] == "ERROR" { yield left }
        make right := verify_ir(ir[4])
        when right[0] == "ERROR" { yield right }
        when ir[5] < 1 or ir[6] < 1 { yield ir_failure("invalid binary span", ir[5], ir[6]) }
        yield ["OK"]
    }

    when kind == "call" {
        when size(ir) != 6 { yield ir_failure("invalid call shape", 1, 1) }
        make callee := verify_ir(ir[2])
        when callee[0] == "ERROR" { yield callee }
        vary argument_index := 0
        loop while argument_index < size(ir[3]) {
            make argument := verify_ir(ir[3][argument_index])
            when argument[0] == "ERROR" { yield argument }
            change argument_index := argument_index + 1
        }
        when ir[4] < 1 or ir[5] < 1 { yield ir_failure("invalid call span", ir[4], ir[5]) }
        yield ["OK"]
    }

    when kind == "list" {
        when size(ir) != 5 { yield ir_failure("invalid list shape", 1, 1) }
        vary item_index := 0
        loop while item_index < size(ir[2]) {
            make item := verify_ir(ir[2][item_index])
            when item[0] == "ERROR" { yield item }
            change item_index := item_index + 1
        }
        when ir[3] < 1 or ir[4] < 1 { yield ir_failure("invalid list span", ir[3], ir[4]) }
        yield ["OK"]
    }

    when kind == "index" {
        when size(ir) != 6 { yield ir_failure("invalid index shape", 1, 1) }
        make collection := verify_ir(ir[2])
        when collection[0] == "ERROR" { yield collection }
        make index_expression := verify_ir(ir[3])
        when index_expression[0] == "ERROR" { yield index_expression }
        when ir[4] < 1 or ir[5] < 1 { yield ir_failure("invalid index span", ir[4], ir[5]) }
        yield ["OK"]
    }

    yield ir_failure("unknown RIR1 node kind: " ++ kind, 1, 1)
}

craft emit_ir(ir, code) {
    make kind := ir[1]

    when kind == "const" {
        yield push(code, ["CONST", ir[2], ir[3], ir[4], ir[5]])
    }
    when kind == "load" {
        yield push(code, ["LOAD", ir[2], ir[3], ir[4]])
    }
    when kind == "unary" {
        make nested := emit_ir(ir[3], code)
        yield push(nested, ["UNARY", ir[2], ir[4], ir[5]])
    }
    when kind == "binary" {
        make left_code := emit_ir(ir[3], code)
        make right_code := emit_ir(ir[4], left_code)
        yield push(right_code, ["BINARY", ir[2], ir[5], ir[6]])
    }
    when kind == "call" {
        make callee_code := emit_ir(ir[2], code)
        vary argument_code := callee_code
        vary argument_index := 0
        loop while argument_index < size(ir[3]) {
            change argument_code := emit_ir(ir[3][argument_index], argument_code)
            change argument_index := argument_index + 1
        }
        yield push(argument_code, ["CALL", size(ir[3]), ir[4], ir[5]])
    }
    when kind == "list" {
        vary item_code := code
        vary item_index := 0
        loop while item_index < size(ir[2]) {
            change item_code := emit_ir(ir[2][item_index], item_code)
            change item_index := item_index + 1
        }
        yield push(item_code, ["BUILD_LIST", size(ir[2]), ir[3], ir[4]])
    }
    when kind == "index" {
        make collection_code := emit_ir(ir[2], code)
        make index_code := emit_ir(ir[3], collection_code)
        yield push(index_code, ["INDEX", ir[4], ir[5]])
    }

    yield code
}

craft verify_bytecode(code) {
    vary stack_depth := 0
    vary maximum_depth := 0
    vary instruction_index := 0

    when size(code) == 0 {
        yield ir_failure("bytecode cannot be empty", 1, 1)
    }

    loop while instruction_index < size(code) {
        make instruction := code[instruction_index]
        when size(instruction) == 0 {
            yield ir_failure("empty bytecode instruction", 1, instruction_index + 1)
        }
        make opcode := instruction[0]

        when opcode == "CONST" {
            when size(instruction) != 5 { yield ir_failure("invalid CONST instruction", 1, instruction_index + 1) }
            when instruction[1] != "NUMBER" and instruction[1] != "STRING" and instruction[1] != "TRUE" and instruction[1] != "FALSE" and instruction[1] != "NOTHING" {
                yield ir_failure("invalid CONST kind", instruction[3], instruction[4])
            }
            when instruction[3] < 1 or instruction[4] < 1 { yield ir_failure("invalid CONST span", instruction[3], instruction[4]) }
            change stack_depth := stack_depth + 1
        } otherwise {
            when opcode == "LOAD" {
                when size(instruction) != 4 { yield ir_failure("invalid LOAD instruction", 1, instruction_index + 1) }
                when instruction[1] == "" { yield ir_failure("LOAD name cannot be empty", instruction[2], instruction[3]) }
                when instruction[2] < 1 or instruction[3] < 1 { yield ir_failure("invalid LOAD span", instruction[2], instruction[3]) }
                change stack_depth := stack_depth + 1
            } otherwise {
                when opcode == "UNARY" {
                    when size(instruction) != 4 { yield ir_failure("invalid UNARY instruction", 1, instruction_index + 1) }
                    when instruction[1] != "-" and instruction[1] != "NOT" { yield ir_failure("unknown UNARY operator", instruction[2], instruction[3]) }
                    when instruction[2] < 1 or instruction[3] < 1 { yield ir_failure("invalid UNARY span", instruction[2], instruction[3]) }
                    when stack_depth < 1 { yield ir_failure("stack underflow at UNARY", instruction[2], instruction[3]) }
                } otherwise {
                    when opcode == "BINARY" or opcode == "INDEX" {
                        when opcode == "BINARY" and size(instruction) != 4 { yield ir_failure("invalid BINARY instruction", 1, instruction_index + 1) }
                        when opcode == "INDEX" and size(instruction) != 3 { yield ir_failure("invalid INDEX instruction", 1, instruction_index + 1) }
                        when opcode == "BINARY" and not known_ir_binary_operator(instruction[1]) { yield ir_failure("unknown BINARY operator", instruction[2], instruction[3]) }
                        when opcode == "BINARY" and (instruction[2] < 1 or instruction[3] < 1) { yield ir_failure("invalid BINARY span", instruction[2], instruction[3]) }
                        when opcode == "INDEX" and (instruction[1] < 1 or instruction[2] < 1) { yield ir_failure("invalid INDEX span", instruction[1], instruction[2]) }
                        when stack_depth < 2 { yield ir_failure("stack underflow at " ++ opcode, 1, instruction_index + 1) }
                        change stack_depth := stack_depth - 1
                    } otherwise {
                        when opcode == "CALL" {
                            when size(instruction) != 4 { yield ir_failure("invalid CALL instruction", 1, instruction_index + 1) }
                            when instruction[1] < 0 { yield ir_failure("CALL arity cannot be negative", instruction[2], instruction[3]) }
                            when instruction[2] < 1 or instruction[3] < 1 { yield ir_failure("invalid CALL span", instruction[2], instruction[3]) }
                            when stack_depth < instruction[1] + 1 { yield ir_failure("stack underflow at CALL", instruction[2], instruction[3]) }
                            change stack_depth := stack_depth - instruction[1]
                        } otherwise {
                            when opcode == "BUILD_LIST" {
                                when size(instruction) != 4 { yield ir_failure("invalid BUILD_LIST instruction", 1, instruction_index + 1) }
                                when instruction[1] < 0 { yield ir_failure("BUILD_LIST count cannot be negative", instruction[2], instruction[3]) }
                                when instruction[2] < 1 or instruction[3] < 1 { yield ir_failure("invalid BUILD_LIST span", instruction[2], instruction[3]) }
                                when stack_depth < instruction[1] { yield ir_failure("stack underflow at BUILD_LIST", instruction[2], instruction[3]) }
                                change stack_depth := stack_depth - instruction[1] + 1
                            } otherwise {
                                yield ir_failure("unknown bytecode opcode: " ++ opcode, 1, instruction_index + 1)
                            }
                        }
                    }
                }
            }
        }

        when stack_depth > maximum_depth {
            change maximum_depth := stack_depth
        }
        change instruction_index := instruction_index + 1
    }

    when stack_depth != 1 {
        yield ir_failure("expression bytecode must leave exactly one stack value", 1, size(code) + 1)
    }
    yield ["OK", maximum_depth]
}

craft compile_expression(ast) {
    make ir := lower_expression(ast)
    when ir[0] == "ERROR" { yield ir }
    make checked_ir := verify_ir(ir)
    when checked_ir[0] == "ERROR" { yield checked_ir }
    make bytecode := emit_ir(ir, [])
    make checked_bytecode := verify_bytecode(bytecode)
    when checked_bytecode[0] == "ERROR" { yield checked_bytecode }
    yield ["OK", ir, bytecode, checked_bytecode[1]]
}

# Arithmetic lowers deterministically and needs at most three stack slots.
make arithmetic_ast := [
    "binary", "+",
    ["literal", "NUMBER", "2", 1, 1],
    [
        "binary", "*",
        ["literal", "NUMBER", "3", 1, 5],
        ["literal", "NUMBER", "4", 1, 9],
        1, 7
    ],
    1, 3
]
make arithmetic_ir := lower_expression(arithmetic_ast)
assert(arithmetic_ir[0] == "RIR1" and verify_ir(arithmetic_ir)[0] == "OK", "RIR1 arithmetic lowering failed")

make arithmetic_code := compile_expression(arithmetic_ast)
assert(arithmetic_code[0] == "OK", "arithmetic bytecode compilation failed")
assert(size(arithmetic_code[2]) == 5, "arithmetic instruction count mismatch")
assert(arithmetic_code[3] == 3, "arithmetic maximum stack depth mismatch")

# Calls evaluate the callee followed by arguments, then consume arity + 1 slots.
make call_ast := [
    "call",
    ["name", "sum", 2, 1],
    [
        ["literal", "NUMBER", "2", 2, 5],
        ["literal", "NUMBER", "3", 2, 8]
    ],
    2, 4
]
make call_code := compile_expression(call_ast)
assert(call_code[0] == "OK" and call_code[2][3][0] == "CALL", "call bytecode shape mismatch")

# A malformed tree and an underflowing stack program must fail closed.
make malformed_ast := ["binary", "?", ["literal", "NUMBER", "1", 1, 1], ["literal", "NUMBER", "2", 1, 5], 1, 3]
assert(lower_expression(malformed_ast)[0] == "ERROR", "unknown AST operator was accepted")

make underflow_code := verify_bytecode([["BINARY", "+", 1, 1], ["CONST", "NUMBER", "1", 1, 5]])
assert(underflow_code[0] == "ERROR", "bytecode stack underflow was accepted")

make invalid_span := verify_ir(["RIR1", "const", "NUMBER", "1", 0, 1])
assert(invalid_span[0] == "ERROR", "zero line span was accepted")

make invalid_opcode_code := verify_bytecode([
    ["CONST", "NUMBER", "1", 1, 1],
    ["CONST", "NUMBER", "2", 1, 5],
    ["BINARY", "???", 1, 3]
])
assert(invalid_opcode_code[0] == "ERROR", "unknown bytecode operator was accepted")

make invalid_instruction_span := verify_bytecode([
    ["CONST", "NUMBER", "1", 1, 1],
    ["UNARY", "-", 0, 2]
])
assert(invalid_instruction_span[0] == "ERROR", "invalid bytecode source span was accepted")

emit "SELFHOST_IR_OK"
