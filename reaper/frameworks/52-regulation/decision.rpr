# Regulation Decision Framework — Resolve exact policy matches with explicit deny taking precedence over allow.

export craft regulation_decide(subject, resource, action, rules) {
when kind(subject) != "text" or kind(resource) != "text" or kind(action) != "text" or kind(rules) != "list" { yield "deny" }
 vary allowed := false
 each rule in rules {
  when kind(rule) == "list" and size(rule) == 4 {
   when rule[0] == subject and rule[1] == resource and rule[2] == action {
    when rule[3] == "deny" { yield "deny" }
    when rule[3] == "allow" { change allowed := true }
   }
  }
 }
 when allowed { yield "allow" }
 yield "deny"
}
