# Regulation Decision Framework — Resolve exact policy matches with explicit deny taking precedence over allow.

export craft regulation_decide(subject, resource, action, rules) {
    when kind(subject) != "text" or kind(resource) != "text" or kind(action) != "text" or kind(rules) != "list" {
        yield "deny"
    }
    craft valid_rule(rule) {
        when kind(rule) != "list" or size(rule) != 4 {
            yield false
        }
        each index in [0, 1, 2, 3] {
            when kind(rule[index]) != "text" or size(trim(rule[index])) == 0 {
                yield false
            }
        }
        yield contains(["allow", "deny"], rule[3])
    }
    craft invalid_rule(rule) {
        yield not valid_rule(rule)
    }
    when size(keep(rules, invalid_rule)) != 0 or size(unique(rules)) != size(rules) {
        yield "deny"
    }
    vary allowed := false
    each rule in rules {
        when rule[0] == subject and rule[1] == resource and rule[2] == action {
            when rule[3] == "deny" {
                yield "deny"
            }
            when rule[3] == "allow" {
                change allowed := true
            }
        }
    }
    when allowed {
        yield "allow"
    }
    yield "deny"
}
