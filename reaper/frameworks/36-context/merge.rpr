# ContextMerge — ordered context merge; local entries shadow base values.

export craft context_merge_values(base, local_values) {
    when kind(base) != "list" or kind(local_values) != "list" {
        yield []
    }
    craft valid_entry(entry) {
        when kind(entry) != "list" or size(entry) != 2 {
            yield false
        }
        when kind(entry[0]) != "text" or size(trim(entry[0])) == 0 {
            yield false
        }
        yield true
    }
    craft invalid_entry(entry) {
        yield not valid_entry(entry)
    }
    craft entry_key(entry) {
        yield entry[0]
    }
    when size(keep(base, invalid_entry)) != 0 or size(keep(local_values, invalid_entry)) != 0 {
        yield []
    }
    when size(unique(map(base, entry_key))) != size(base) or size(unique(map(local_values, entry_key))) != size(local_values) {
        yield []
    }
    vary merged := base
    each entry in local_values {
        vary replaced := false
        vary next := []
        each current in merged {
            when current[0] == entry[0] {
                change next := push(next, entry)
                change replaced := true
            } otherwise {
                change next := push(next, current)
            }
        }
        when not replaced {
            change next := push(next, entry)
        }
        change merged := next
    }
    yield merged
}
