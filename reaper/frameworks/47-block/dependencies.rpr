# Block Dependency Framework — Validate forward-only block dependencies, making cycles impossible by construction.

export craft valid_block_dependencies(count, edges) {
when kind(count) != "number" or count % 1 != 0 or count < 1 or kind(edges) != "list" { yield false }
    craft valid_edge(edge) {
        yield kind(edge) == "list" and size(edge) == 2 and kind(edge[0]) == "number" and kind(edge[1]) == "number" and edge[0] % 1 == 0 and edge[1] % 1 == 0 and edge[0] >= 0 and edge[0] < edge[1] and edge[1] < count
    }
    craft invalid_edge(edge) { yield not valid_edge(edge) }
    yield size(keep(edges, invalid_edge)) == 0 and size(unique(edges)) == size(edges)
}
