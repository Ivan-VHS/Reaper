# Software Skeleton Application Framework — Validate app identity, semantic version, entry module/function and unique module inventory.

export craft valid_software_skeleton_manifest(name, version, entry_module, entry_function, modules) {
when kind(name) != "text" or kind(version) != "list" or kind(entry_module) != "text" or kind(entry_function) != "text" or kind(modules) != "list" { yield false }
 when size(trim(name)) == 0 or size(trim(entry_module)) == 0 or size(trim(entry_function)) == 0 or size(version) != 3 or size(modules) == 0 { yield false }
 each part in version { when kind(part) != "number" or part % 1 != 0 or part < 0 { yield false } }
 craft invalid_module(item) { yield kind(item) != "text" or size(trim(item)) == 0 }
 yield size(keep(modules, invalid_module)) == 0 and size(unique(modules)) == size(modules) and contains(modules, entry_module)
}
