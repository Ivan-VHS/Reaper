# PackageLock — validate unique package identities and exact semantic versions.

export craft valid_package_lock(entries) {
    when kind(entries) != "list" or size(entries) == 0 {
        yield false
    }
    craft valid_entry(entry) {
        when kind(entry) != "list" or size(entry) != 2 {
            yield false
        }
        when kind(entry[0]) != "text" or kind(entry[1]) != "list" or size(entry[1]) != 3 {
            yield false
        }
        when size(trim(entry[0])) == 0 {
            yield false
        }
        each part in entry[1] {
            when kind(part) != "number" or part % 1 != 0 or part < 0 {
                yield false
            }
        }
        yield true
    }
    craft invalid_entry(entry) {
        yield not valid_entry(entry)
    }
    craft package_name(entry) {
        yield entry[0]
    }
    when size(keep(entries, invalid_entry)) != 0 {
        yield false
    }
    yield size(unique(map(entries, package_name))) == size(entries)
}
