# PackageManifest — validate package identity, version, checksum metadata and format.

export craft valid_package_manifest(manifest) {
    when kind(manifest) != "list" or size(manifest) != 4 {
        yield false
    }
    when kind(manifest[0]) != "text" or kind(manifest[1]) != "list" or kind(manifest[2]) != "text" or kind(manifest[3]) != "text" {
        yield false
    }
    when size(trim(manifest[0])) == 0 or size(manifest[1]) != 3 or size(trim(manifest[2])) < 12 {
        yield false
    }
    each part in manifest[1] {
        when kind(part) != "number" or part % 1 != 0 or part < 0 {
            yield false
        }
    }
    when not starts_with(manifest[2], "sha256:") or not contains(["rpk", "tar", "zip"], manifest[3]) {
        yield false
    }
    yield true
}
