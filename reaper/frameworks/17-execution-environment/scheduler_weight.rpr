# ExecutionSchedulerWeight — validate unique positive task scheduling weights.

export craft valid_execution_scheduler_weights(tasks) {
    when kind(tasks) != "list" or size(tasks) == 0 {
        yield false
    }
    craft valid_task(task) {
        when kind(task) != "list" or size(task) != 2 {
            yield false
        }
        when kind(task[0]) != "text" or kind(task[1]) != "number" {
            yield false
        }
        when size(trim(task[0])) == 0 or task[1] % 1 != 0 {
            yield false
        }
        yield task[1] >= 1 and task[1] <= 100000
    }
    craft invalid_task(task) {
        yield not valid_task(task)
    }
    craft task_id(task) {
        yield task[0]
    }
    when size(keep(tasks, invalid_task)) != 0 or size(unique(map(tasks, task_id))) != size(tasks) {
        yield false
    }
    vary total := 0
    each task in tasks {
        change total := total + task[1]
    }
    yield total <= 1000000
}
