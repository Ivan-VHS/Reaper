# BoilerplateLicense — validate a generated project license identifier.

export craft valid_boilerplate_license(identifier) {
    when kind(identifier) != "text" {
        yield false
    }
    yield contains(["Apache-2.0", "MIT", "BSD-2-Clause", "BSD-3-Clause", "MPL-2.0", "GPL-3.0-only", "LGPL-3.0-only", "Unlicense"], identifier)
}
