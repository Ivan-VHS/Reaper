# BoilerplateRenderBudget — estimate generated bytes from source size and token count.

export craft boilerplate_render_within_budget(source_bytes, replacement_count, output_limit) {
    when kind(source_bytes) != "number" or kind(replacement_count) != "number" or kind(output_limit) != "number" {
        yield false
    }
    when source_bytes % 1 != 0 or replacement_count % 1 != 0 or output_limit % 1 != 0 {
        yield false
    }
    when source_bytes < 0 or replacement_count < 0 or replacement_count > 10000 or output_limit < 0 {
        yield false
    }
    yield source_bytes * (replacement_count + 1) <= output_limit
}
