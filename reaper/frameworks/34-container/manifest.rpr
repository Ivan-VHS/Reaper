# ContainerManifest — validate a bounded declarative container image profile.
# [name, semver, rootfs_bytes, network_mode, privilege_profile].

export craft valid_container_manifest(manifest) {
    when kind(manifest) != "list" or size(manifest) != 5 {
        yield false
    }
    when kind(manifest[0]) != "text" or kind(manifest[1]) != "list" or kind(manifest[2]) != "number" or kind(manifest[3]) != "text" or kind(manifest[4]) != "text" {
        yield false
    }
    when size(trim(manifest[0])) == 0 or size(manifest[1]) != 3 or manifest[2] % 1 != 0 or manifest[2] < 1 or manifest[2] > 68719476736 {
        yield false
    }
    each part in manifest[1] {
        when kind(part) != "number" or part % 1 != 0 or part < 0 {
            yield false
        }
    }
    when not contains(["none", "isolated", "host"], manifest[3]) or not contains(["unprivileged", "capability-scoped"], manifest[4]) {
        yield false
    }
    yield not (manifest[3] == "host" and manifest[4] == "capability-scoped")
}
