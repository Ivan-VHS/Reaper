# Schema Record Framework — Check record field types, unique keys and required schema fields.

export craft schema_accepts_record(values, fields) {
    when kind(values) != "list" or kind(fields) != "list" {
        yield false
    }
    craft valid_field(field) {
        yield kind(field) == "list" and size(field) == 3 and kind(field[0]) == "text" and kind(field[1]) == "text" and kind(field[2]) == "boolean" and size(trim(field[0])) > 0 and contains(["integer", "number", "text", "boolean", "list", "map", "nothing"], field[1])
    }
    craft invalid_field(field) {
        yield not valid_field(field)
    }
    craft valid_value(item) {
        yield kind(item) == "list" and size(item) == 2 and kind(item[0]) == "text" and size(trim(item[0])) > 0
    }
    craft invalid_value(item) {
        yield not valid_value(item)
    }
    craft schema_name(field) {
        yield field[0]
    }
    craft value_name(item) {
        yield item[0]
    }
    when size(keep(fields, invalid_field)) != 0 or size(keep(values, invalid_value)) != 0 {
        yield false
    }
    when size(unique(map(fields, schema_name))) != size(fields) or size(unique(map(values, value_name))) != size(values) {
        yield false
    }
    craft unknown(item) {
        yield not contains(map(fields, schema_name), item[0])
    }
    craft absent(field) {
        yield field[2] and not contains(map(values, value_name), field[0])
    }
    craft type_mismatch(item) {
        vary matched := false
        each field in fields {
            when field[0] == item[0] {
                when field[1] == "integer" {
                    change matched := kind(item[1]) == "number" and item[1] % 1 == 0
                }
                when field[1] == "number" {
                    change matched := kind(item[1]) == "number"
                }
                when field[1] == "text" {
                    change matched := kind(item[1]) == "text"
                }
                when field[1] == "boolean" {
                    change matched := kind(item[1]) == "boolean"
                }
                when field[1] == "list" {
                    change matched := kind(item[1]) == "list"
                }
                when field[1] == "map" {
                    change matched := kind(item[1]) == "map"
                }
                when field[1] == "nothing" {
                    change matched := kind(item[1]) == "nothing"
                }
            }
        }
        yield not matched
    }
    yield size(keep(values, unknown)) == 0 and size(keep(values, type_mismatch)) == 0 and size(keep(fields, absent)) == 0
}
