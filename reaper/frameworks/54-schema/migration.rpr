# Schema Migration Framework — Allow only forward schema migration versions with non-negative integer components.

export craft valid_schema_migration(from_version, to_version) {
craft valid_version(version) {
  when kind(version) != "list" or size(version) != 2 { yield false }
  each part in version { when kind(part) != "number" or part % 1 != 0 or part < 0 { yield false } }
  yield true
 }
 when not valid_version(from_version) or not valid_version(to_version) { yield false }
 yield to_version[0] > from_version[0] or (to_version[0] == from_version[0] and to_version[1] > from_version[1])
}
