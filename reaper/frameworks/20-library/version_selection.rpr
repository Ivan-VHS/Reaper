# LibraryVersionSelection — choose the greatest semantic version on a requested major line.

export craft library_select_highest_version(versions, required_major) {
    when kind(versions) != "list" or kind(required_major) != "number" or required_major % 1 != 0 {
        yield []
    }
    craft valid_version(version) {
        when kind(version) != "list" or size(version) != 3 {
            yield false
        }
        each part in version {
            when kind(part) != "number" or part % 1 != 0 or part < 0 {
                yield false
            }
        }
        yield true
    }
    craft invalid_version(version) {
        yield not valid_version(version)
    }
    when size(keep(versions, invalid_version)) != 0 {
        yield []
    }
    vary selected := []
    each version in versions {
        when version[0] == required_major {
            when size(selected) == 0 {
                change selected := version
            } otherwise {
                when version[1] > selected[1] or (version[1] == selected[1] and version[2] > selected[2]) {
                    change selected := version
                }
            }
        }
    }
    yield selected
}
