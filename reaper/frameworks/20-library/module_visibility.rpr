# LibraryModuleVisibility — validate module visibility assignments.

export craft valid_library_module_visibility(modules) {
    when kind(modules) != "list" or size(modules) == 0 {
        yield false
    }
    craft valid_module(module) {
        when kind(module) != "list" or size(module) != 2 {
            yield false
        }
        when kind(module[0]) != "text" or kind(module[1]) != "text" {
            yield false
        }
        yield size(trim(module[0])) > 0 and contains(["public", "private"], module[1])
    }
    craft invalid_module(module) {
        yield not valid_module(module)
    }
    craft module_name(module) {
        yield module[0]
    }
    when size(keep(modules, invalid_module)) != 0 {
        yield false
    }
    yield size(unique(map(modules, module_name))) == size(modules)
}
