# ArchitectureContractCompatibility — same-major, non-regressing semantic versions.

export craft architecture_contract_compatible(required_version, offered_version) {
    craft valid_version(version) {
        when kind(version) != "list" or size(version) != 3 {
            yield false
        }
        each part in version {
            when kind(part) != "number" or part % 1 != 0 or part < 0 {
                yield false
            }
        }
        yield true
    }
    when not valid_version(required_version) or not valid_version(offered_version) {
        yield false
    }
    when required_version[0] != offered_version[0] {
        yield false
    }
    when offered_version[1] > required_version[1] {
        yield true
    }
    when offered_version[1] < required_version[1] {
        yield false
    }
    yield offered_version[2] >= required_version[2]
}
