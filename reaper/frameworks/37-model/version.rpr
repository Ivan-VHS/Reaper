# ModelVersion — check model compatibility by major version.

export craft model_version_compatible(required, offered) {
    craft valid_version(version) {
        when kind(version) != "list" or size(version) != 2 {
            yield false
        }
        each part in version {
            when kind(part) != "number" or part % 1 != 0 or part < 0 {
                yield false
            }
        }
        yield true
    }
    when not valid_version(required) or not valid_version(offered) {
        yield false
    }
    yield required[0] == offered[0] and offered[1] >= required[1]
}
