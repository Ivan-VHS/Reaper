# InfrastructureServiceGraph — ordered service start graph.
# Dependencies must point from a prerequisite to a later service.

export craft valid_infrastructure_service_graph(service_count, edges) {
    when kind(service_count) != "number" or service_count % 1 != 0 or service_count < 1 {
        yield false
    }
    when kind(edges) != "list" {
        yield false
    }
    craft valid_edge(edge) {
        when kind(edge) != "list" or size(edge) != 2 {
            yield false
        }
        when kind(edge[0]) != "number" or kind(edge[1]) != "number" {
            yield false
        }
        when edge[0] % 1 != 0 or edge[1] % 1 != 0 {
            yield false
        }
        yield edge[0] >= 0 and edge[0] < edge[1] and edge[1] < service_count
    }
    craft invalid_edge(edge) {
        yield not valid_edge(edge)
    }
    when size(keep(edges, invalid_edge)) != 0 {
        yield false
    }
    yield size(unique(edges)) == size(edges)
}
