# ToolingCapabilityProfile — missing declared capabilities for a selected tool.

export craft tooling_capability_profile(required, available) {
    when kind(required) != "list" or kind(available) != "list" {
        yield []
    }
    craft invalid_capability(value) {
        yield kind(value) != "text" or size(trim(value)) == 0
    }
    when size(keep(required, invalid_capability)) != 0 or size(keep(available, invalid_capability)) != 0 {
        yield []
    }
    when size(unique(required)) != size(required) or size(unique(available)) != size(available) {
        yield []
    }
    craft missing(capability) {
        yield not contains(available, capability)
    }
    yield keep(required, missing)
}
