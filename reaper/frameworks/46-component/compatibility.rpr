# ComponentCompatibility — check offered semantic version against inclusive bounds.

export craft component_contract_compatible(offered, lower, upper) {
    craft valid_version(version) {
        when kind(version) != "list" or size(version) != 2 {
            yield false
        }
        each part in version {
            when kind(part) != "number" or part % 1 != 0 or part < 0 {
                yield false
            }
        }
        yield true
    }
    when not valid_version(offered) or not valid_version(lower) or not valid_version(upper) {
        yield false
    }
    when lower[0] != upper[0] or offered[0] != lower[0] {
        yield false
    }
    yield offered[1] >= lower[1] and offered[1] <= upper[1] and lower[1] <= upper[1]
}
