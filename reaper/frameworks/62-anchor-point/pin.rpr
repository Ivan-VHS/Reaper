# Anchor Version Pin Framework — Require an anchor's actual version to match its explicitly pinned version.

export craft anchor_version_pinned(actual, pinned) {
craft valid_version(version) {
  when kind(version) != "list" or size(version) != 3 { yield false }
  each part in version { when kind(part) != "number" or part % 1 != 0 or part < 0 { yield false } }
  yield true
 }
 when not valid_version(actual) or not valid_version(pinned) { yield false }
 yield actual[0] == pinned[0] and actual[1] == pinned[1] and actual[2] == pinned[2]
}
