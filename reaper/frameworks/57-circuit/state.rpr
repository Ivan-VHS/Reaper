# Circuit State Framework — Replay circuit states through explicitly declared transitions.

export craft valid_circuit_state_sequence(initial, steps, transitions) {
when kind(initial) != "text" or kind(steps) != "list" or kind(transitions) != "list" { yield false }
 craft valid_transition(item) { yield kind(item) == "list" and size(item) == 2 and kind(item[0]) == "text" and kind(item[1]) == "text" and size(trim(item[0])) > 0 and size(trim(item[1])) > 0 }
 craft invalid_transition(item) { yield not valid_transition(item) }
 when size(keep(transitions, invalid_transition)) != 0 or size(unique(transitions)) != size(transitions) { yield false }
 vary current := initial
 vary valid := true
 each next in steps {
  when valid {
   when contains(transitions, [current, next]) { change current := next }
   otherwise { change valid := false }
  }
 }
 yield valid
}
