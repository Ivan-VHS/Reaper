# TemplateVersion — validate a versioned template identity and schema number.

export craft valid_template_version(template) {
    when kind(template) != "list" or size(template) != 3 {
        yield false
    }
    when kind(template[0]) != "text" or kind(template[1]) != "list" or kind(template[2]) != "number" {
        yield false
    }
    when size(trim(template[0])) == 0 or size(template[1]) != 3 or template[2] % 1 != 0 or template[2] != 1 {
        yield false
    }
    each part in template[1] {
        when kind(part) != "number" or part % 1 != 0 or part < 0 {
            yield false
        }
    }
    yield true
}
