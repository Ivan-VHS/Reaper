# Perimeter Zone Framework — Validate a named trust zone with a bounded integer trust level.

export craft valid_perimeter_zone(zone) {
when kind(zone) != "list" or size(zone) != 2 or kind(zone[0]) != "text" or kind(zone[1]) != "number" { yield false }
 yield size(trim(zone[0])) > 0 and zone[1] % 1 == 0 and zone[1] >= 0 and zone[1] <= 5
}
