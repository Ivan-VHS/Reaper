# Specification Version Framework — Validate a non-negative three-part specification version.

export craft valid_spec_version(version) {
when kind(version) != "list" or size(version) != 3 { yield false }
 each part in version {
  when kind(part) != "number" or part % 1 != 0 or part < 0 { yield false }
 }
 yield true
}
