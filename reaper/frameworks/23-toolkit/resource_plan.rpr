# ToolkitResourcePlan — return residual resource budget after component allocations.

export craft toolkit_resource_plan(allocations, total_budget) {
    when kind(allocations) != "list" or kind(total_budget) != "number" {
        yield []
    }
    when total_budget % 1 != 0 or total_budget < 0 {
        yield []
    }
    vary used := 0
    each allocation in allocations {
        when kind(allocation) != "list" or size(allocation) != 2 or kind(allocation[0]) != "text" or kind(allocation[1]) != "number" {
            yield []
        }
        when size(trim(allocation[0])) == 0 or allocation[1] % 1 != 0 or allocation[1] < 0 {
            yield []
        }
        change used := used + allocation[1]
    }
    when used > total_budget {
        yield []
    }
    yield total_budget - used
}
