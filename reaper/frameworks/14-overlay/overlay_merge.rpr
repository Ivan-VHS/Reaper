# OverlayMerge — ordered overlay merge; later layers replace earlier values.
# Each layer contains unique [key, value] text pairs.

export craft overlay_merge_layers(layers) {
    when kind(layers) != "list" {
        yield []
    }
    vary merged := []
    each layer in layers {
        when kind(layer) != "list" {
            yield []
        }
        craft valid_entry(entry) {
            when kind(entry) != "list" or size(entry) != 2 {
                yield false
            }
            when kind(entry[0]) != "text" or kind(entry[1]) != "text" {
                yield false
            }
            yield size(trim(entry[0])) > 0
        }
        craft invalid_entry(entry) {
            yield not valid_entry(entry)
        }
        craft entry_key(entry) {
            yield entry[0]
        }
        when size(keep(layer, invalid_entry)) != 0 or size(unique(map(layer, entry_key))) != size(layer) {
            yield []
        }
        each entry in layer {
            vary replaced := false
            vary next := []
            each current in merged {
                when current[0] == entry[0] {
                    change next := push(next, entry)
                    change replaced := true
                } otherwise {
                    change next := push(next, current)
                }
            }
            when not replaced {
                change next := push(next, entry)
            }
            change merged := next
        }
    }
    yield merged
}
