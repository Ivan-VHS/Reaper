# ConceptConstraints — validate unique constraints and supported numeric operators.

export craft valid_concept_constraints(constraints) {
    when kind(constraints) != "list" {
        yield false
    }
    craft valid_constraint(item) {
        when kind(item) != "list" or size(item) != 3 {
            yield false
        }
        when kind(item[0]) != "text" or kind(item[1]) != "text" or kind(item[2]) != "number" {
            yield false
        }
        yield size(trim(item[0])) > 0 and contains(["eq", "gte", "lte"], item[1])
    }
    craft invalid_constraint(item) {
        yield not valid_constraint(item)
    }
    craft constraint_name(item) {
        yield item[0]
    }
    when size(keep(constraints, invalid_constraint)) != 0 {
        yield false
    }
    yield size(unique(map(constraints, constraint_name))) == size(constraints)
}
