# ConceptRelations — validate concept relation edges as a DAG.

export craft valid_concept_relations(concept_count, relations) {
    when kind(concept_count) != "number" or concept_count % 1 != 0 or concept_count < 1 {
        yield false
    }
    when kind(relations) != "list" {
        yield false
    }
    craft valid_edge(edge) {
        when kind(edge) != "list" or size(edge) != 2 {
            yield false
        }
        when kind(edge[0]) != "number" or kind(edge[1]) != "number" {
            yield false
        }
        when edge[0] % 1 != 0 or edge[1] % 1 != 0 {
            yield false
        }
        yield edge[0] >= 0 and edge[0] < concept_count and edge[1] >= 0 and edge[1] < concept_count and edge[0] != edge[1]
    }
    craft invalid_edge(edge) {
        yield not valid_edge(edge)
    }
    when size(keep(relations, invalid_edge)) != 0 or size(unique(relations)) != size(relations) {
        yield false
    }
    vary removed := []
    while size(removed) < concept_count {
        vary candidate := -1
        each node in range(0, concept_count) {
            when not contains(removed, node) {
                vary blocked := false
                each edge in relations {
                    when edge[1] == node and not contains(removed, edge[0]) {
                        change blocked := true
                    }
                }
                when not blocked and candidate == -1 {
                    change candidate := node
                }
            }
        }
        when candidate == -1 {
            yield false
        }
        change removed := push(removed, candidate)
    }
    yield true
}
