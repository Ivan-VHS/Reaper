# BasisIntegerRange — fixed-width signed and unsigned integer bounds.

export craft valid_basis_integer(value, bits, signed) {
    when kind(value) != "number" or kind(bits) != "number" or kind(signed) != "boolean" {
        yield false
    }
    when value % 1 != 0 or bits % 1 != 0 {
        yield false
    }
    when not contains([8, 16, 32, 64, 128], bits) {
        yield false
    }
    vary half_range := 2 ** (bits - 1)
    when signed {
        yield value >= (0 - half_range) and value < half_range
    }
    yield value >= 0 and value < (half_range * 2)
}
