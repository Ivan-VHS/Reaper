# BasisCheckedAdd — fixed-width addition with explicit signedness.

export craft checked_basis_add(left, right, bits, signed) {
    when kind(left) != "number" or kind(right) != "number" or kind(bits) != "number" or kind(signed) != "boolean" {
        yield []
    }
    when left % 1 != 0 or right % 1 != 0 or bits % 1 != 0 {
        yield []
    }
    when not contains([8, 16, 32, 64, 128], bits) {
        yield []
    }
    vary half_range := 2 ** (bits - 1)
    vary minimum := 0
    vary maximum := (half_range * 2) - 1
    when signed {
        change minimum := 0 - half_range
        change maximum := half_range - 1
    }
    when left < minimum or left > maximum or right < minimum or right > maximum {
        yield []
    }
    vary total := left + right
    when signed {
        when total < (0 - half_range) or total >= half_range {
            yield []
        }
    } otherwise {
        when total < 0 or total >= (half_range * 2) {
            yield []
        }
    }
    yield total
}
