# MiddlewareRequirements — return pipeline requirements absent from host-provided capabilities.

export craft middleware_missing_requirements(required, provided) {
    when kind(required) != "list" or kind(provided) != "list" {
        yield []
    }
    craft invalid_name(value) {
        yield kind(value) != "text" or size(trim(value)) == 0
    }
    when size(keep(required, invalid_name)) != 0 or size(keep(provided, invalid_name)) != 0 {
        yield []
    }
    when size(unique(required)) != size(required) or size(unique(provided)) != size(provided) {
        yield []
    }
    craft missing(requirement) {
        yield not contains(provided, requirement)
    }
    yield keep(required, missing)
}
