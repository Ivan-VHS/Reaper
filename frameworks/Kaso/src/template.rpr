# Kaso: validated template segments and deterministic slot rendering.
export craft template_record(name, segments, required_slots, version) {
    yield [name, segments, required_slots, version]
}

export craft template_binding(name, value) {
    yield [name, value]
}

export craft template_binding_find(bindings, name) {
    vary index := 0
    loop while index < size(bindings) {
        when bindings[index][0] == name { yield [true, bindings[index][1]] }
        change index := index + 1
    }
    yield [false, ""]
}

export craft template_validate_bindings(template, bindings) {
    when size(template) != 4 { yield [false, "invalid_template_shape"] }
    vary index := 0
    loop while index < size(template[2]) {
        make required := template[2][index]
        make found := template_binding_find(bindings, required)
        when not found[0] { yield [false, "missing_slot:" ++ required] }
        change index := index + 1
    }
    yield [true, []]
}

export craft template_validate_segments(segments) {
    vary index := 0
    loop while index < size(segments) {
        when size(segments[index]) != 2 { yield [false, "invalid_segment_shape"] }
        when segments[index][0] != "text" and segments[index][0] != "slot" {
            yield [false, "unknown_segment_kind"]
        }
        change index := index + 1
    }
    yield [true, []]
}

export craft template_render(template, bindings) {
    when size(template) != 4 { yield [false, "invalid_template_shape"] }
    make binding_check := template_validate_bindings(template, bindings)
    when not binding_check[0] { yield binding_check }
    make segment_check := template_validate_segments(template[1])
    when not segment_check[0] { yield segment_check }
    vary output := ""
    vary index := 0
    loop while index < size(template[1]) {
        make segment := template[1][index]
        when segment[0] == "text" {
            change output := output ++ segment[1]
        } otherwise {
            make binding := template_binding_find(bindings, segment[1])
            when not binding[0] { yield [false, "missing_slot:" ++ segment[1]] }
            change output := output ++ text(binding[1])
        }
        change index := index + 1
    }
    yield [true, output]
}

export craft template_set_binding(bindings, name, value) {
    when size(name) == 0 { yield [false, "empty_binding_name"] }
    vary result := []
    vary replaced := false
    vary index := 0
    loop while index < size(bindings) {
        when bindings[index][0] == name {
            change result := push(result, [name, value])
            change replaced := true
        } otherwise {
            change result := push(result, bindings[index])
        }
        change index := index + 1
    }
    when not replaced { change result := push(result, [name, value]) }
    yield [true, result]
}


# Typed template context, escaped interpolation, conditionals and bounded list rendering.
export craft template_context_find(context, name) {
    vary index := 0
    loop while index < size(context) {
        when context[index][0] == name { yield [true, context[index][1]] }
        change index := index + 1
    }
    yield [false, nothing]
}
export craft template_context_set(context, name, value) {
    vary result := []
    vary replaced := false
    vary index := 0
    loop while index < size(context) {
        when context[index][0] == name {
            change result := push(result, [name, value])
            change replaced := true
        } otherwise { change result := push(result, context[index]) }
        change index := index + 1
    }
    when not replaced { change result := push(result, [name, value]) }
    yield [true, result]
}
export craft template_escape_html(value) {
    make source := text(value)
    vary output := ""
    vary index := 0
    loop while index < size(source) {
        make char := source[index]
        when char == "&" { change output := output ++ "&amp;" } otherwise {
            when char == "<" { change output := output ++ "&lt;" } otherwise {
                when char == ">" { change output := output ++ "&gt;" } otherwise {
                    when char == "\"" { change output := output ++ "&quot;" } otherwise {
                        when char == "'" { change output := output ++ "&#39;" } otherwise { change output := output ++ char }
                    }
                }
            }
        }
        change index := index + 1
    }
    yield output
}
export craft template_render_blocks(blocks, context, depth) {
    when depth > 32 { yield [false, "template_depth_exceeded"] }
    vary output := ""
    vary index := 0
    loop while index < size(blocks) {
        make block := blocks[index]
        when size(block) != 2 { yield [false, "invalid_block"] }
        when block[0] == "text" { change output := output ++ block[1] } otherwise {
            when block[0] == "slot" or block[0] == "escaped_slot" {
                make value := template_context_find(context, block[1])
                when not value[0] { yield [false, "missing_slot"] }
                when block[0] == "escaped_slot" { change output := output ++ template_escape_html(value[1]) }
                otherwise { change output := output ++ text(value[1]) }
            } otherwise {
                when block[0] == "when" {
                    when size(block[1]) != 4 { yield [false, "invalid_condition"] }
                    make value := template_context_find(context, block[1][0])
                    when not value[0] { yield [false, "missing_condition"] }
                    vary selected := block[1][3]
                    when value[1] == block[1][1] { change selected := block[1][2] }
                    make nested := template_render_blocks(selected, context, depth + 1)
                    when not nested[0] { yield nested }
                    change output := output ++ nested[1]
                } otherwise { yield [false, "unsupported_block"] }
            }
        }
        change index := index + 1
    }
    yield [true, output]
}
export craft template_render_collection(blocks, context, name, values) {
    when size(values) > 10000 { yield [false, "iteration_limit"] }
    vary output := ""
    vary index := 0
    loop while index < size(values) {
        make local := template_context_set(context, name, values[index])
        make rendered := template_render_blocks(blocks, local[1], 1)
        when not rendered[0] { yield rendered }
        change output := output ++ rendered[1]
        change index := index + 1
    }
    yield [true, output]
}
export craft template_schema_validate(schema, context) {
    vary index := 0
    loop while index < size(schema) {
        when size(schema[index]) != 3 { yield [false, "invalid_schema_entry"] }
        make value := template_context_find(context, schema[index][0])
        when not value[0] {
            when schema[index][2] { yield [false, "required_slot_missing"] }
        } otherwise {
            when schema[index][1] != "any" and kind(value[1]) != schema[index][1] {
                yield [false, "slot_type_mismatch"]
            }
        }
        change index := index + 1
    }
    yield [true, []]
}


# Template defaults, nested paths, render limits and output policies.
export craft template_context_path(context, path) {
    make parts := split(path, ".")
    when size(parts) == 0 { yield [false, "empty_context_path"] }
    make root := template_context_find(context, parts[0])
    when not root[0] { yield [false, "context_root_missing"] }
    vary current := root[1]
    vary index := 1
    loop while index < size(parts) {
        when kind(current) != "map" { yield [false, "context_path_not_a_map"] }
        when not contains(current, parts[index]) { yield [false, "context_path_segment_missing"] }
        change current := current[parts[index]]
        change index := index + 1
    }
    yield [true, current]
}

export craft template_context_default(context, name, default_value) {
    make found := template_context_find(context, name)
    when found[0] { yield [true, found[1], false] }
    yield [true, default_value, true]
}

export craft template_render_default(context, name, default_value) {
    make value := template_context_default(context, name, default_value)
    when not value[0] { yield value }
    yield [true, text(value[1])]
}

export craft template_render_blocks_bounded(blocks, context, depth, max_depth, max_blocks) {
    when max_depth < 0 or max_blocks < 0 { yield [false, "invalid_render_budget"] }
    when depth > max_depth { yield [false, "render_depth_exceeded"] }
    when size(blocks) > max_blocks { yield [false, "render_block_budget_exceeded"] }
    vary output := ""
    vary index := 0
    loop while index < size(blocks) {
        make block := blocks[index]
        when size(block) != 2 { yield [false, "invalid_template_block"] }
        when block[0] == "text" {
            change output := output ++ block[1]
        } otherwise {
            when block[0] == "slot" or block[0] == "escaped_slot" {
                make value := template_context_find(context, block[1])
                when not value[0] { yield [false, "missing_slot:" ++ block[1]] }
                when block[0] == "slot" {
                    change output := output ++ text(value[1])
                } otherwise {
                    change output := output ++ template_escape_html(value[1])
                }
            } otherwise {
                when block[0] == "when" {
                    when size(block[1]) != 4 { yield [false, "invalid_when_block"] }
                    make condition := template_context_find(context, block[1][0])
                    when not condition[0] { yield [false, "missing_condition"] }
                    vary selected := block[1][3]
                    when condition[1] == block[1][1] { change selected := block[1][2] }
                    make nested := template_render_blocks_bounded(selected, context, depth + 1, max_depth, max_blocks)
                    when not nested[0] { yield nested }
                    change output := output ++ nested[1]
                } otherwise {
                    yield [false, "unsupported_template_block"]
                }
            }
        }
        when size(output) > 1000000 { yield [false, "rendered_text_limit_exceeded"] }
        change index := index + 1
    }
    yield [true, output]
}

export craft template_render_optional(blocks, context, condition_name) {
    make condition := template_context_find(context, condition_name)
    when not condition[0] { yield [false, "condition_missing"] }
    when not condition[1] { yield [true, ""] }
    yield template_render_blocks(blocks, context, 0)
}

export craft template_context_remove(context, name) {
    vary result := []
    vary removed := false
    vary index := 0
    loop while index < size(context) {
        when context[index][0] == name {
            change removed := true
        } otherwise {
            change result := push(result, context[index])
        }
        change index := index + 1
    }
    yield [true, result, removed]
}

export craft template_validate_context(context) {
    vary index := 0
    loop while index < size(context) {
        when size(context[index]) != 2 { yield [false, "invalid_context_entry"] }
        when size(context[index][0]) == 0 { yield [false, "empty_context_key"] }
        vary other := index + 1
        loop while other < size(context) {
            when context[index][0] == context[other][0] { yield [false, "duplicate_context_key"] }
            change other := other + 1
        }
        change index := index + 1
    }
    yield [true, []]
}

export craft template_context_overlay(parent, child) {
    make valid_parent := template_validate_context(parent)
    make valid_child := template_validate_context(child)
    when not valid_parent[0] or not valid_child[0] { yield [false, "invalid_template_context"] }
    yield template_context_merge(parent, child)
}

export craft template_render_text_limit(blocks, context, max_chars) {
    when max_chars < 0 { yield [false, "invalid_text_budget"] }
    make rendered := template_render_blocks(blocks, context, 0)
    when not rendered[0] { yield rendered }
    when size(rendered[1]) > max_chars { yield [false, "rendered_text_limit_exceeded"] }
    yield rendered
}
