# Blau: immutable, versioned state snapshots for local-first components.
# Snapshot format: [version, [[key, value], ...]].

craft find_entry(entries, key) {
    vary found := false
    vary value := nothing
    each entry in entries {
        when size(entry) == 2 and entry[0] == key {
            change found := true
            change value := entry[1]
        }
    }
    yield [found, value]
}

craft put_entry(entries, key, value) {
    vary result := []
    vary inserted := false
    each entry in entries {
        when size(entry) == 2 and entry[0] == key {
            when not inserted {
                change result := push(result, [key, value])
                change inserted := true
            }
        } otherwise {
            change result := push(result, entry)
        }
    }
    when not inserted {
        change result := push(result, [key, value])
    }
    yield result
}

export craft empty() {
    yield [0, []]
}

export craft version(snapshot) {
    yield snapshot[0]
}

export craft read(snapshot, key) {
    make result := find_entry(snapshot[1], key)
    yield [result[0], result[1], snapshot[0]]
}

export craft write(snapshot, key, value) {
    make next_entries := put_entry(snapshot[1], key, value)
    yield [snapshot[0] + 1, next_entries]
}

export craft compare_and_set(snapshot, expected_version, key, value) {
    when snapshot[0] != expected_version {
        yield [false, snapshot, "version-conflict"]
    }
    yield [true, write(snapshot, key, value), "committed"]
}

export craft apply(snapshot, writes) {
    vary next_entries := snapshot[1]
    each operation in writes {
        when size(operation) == 2 {
            change next_entries := put_entry(next_entries, operation[0], operation[1])
        }
    }
    yield [snapshot[0] + 1, next_entries]
}

export craft diff(before_snapshot, after_snapshot) {
    vary changes := []

    each entry in after_snapshot[1] {
        make previous := find_entry(before_snapshot[1], entry[0])
        when not previous[0] {
            change changes := push(changes, [entry[0], nothing, entry[1]])
        } otherwise {
            when previous[1] != entry[1] {
                change changes := push(changes, [entry[0], previous[1], entry[1]])
            }
        }
    }

    each entry in before_snapshot[1] {
        make current := find_entry(after_snapshot[1], entry[0])
        when not current[0] {
            change changes := push(changes, [entry[0], entry[1], nothing])
        }
    }

    yield changes
}

craft remove_entry(entries, key) {
    vary result := []
    vary removed := false
    each entry in entries {
        when entry[0] == key {
            change removed := true
        } otherwise {
            change result := push(result, entry)
        }
    }
    yield [result, removed]
}

export craft validate_snapshot(snapshot) {
    when kind(snapshot) != "list" or size(snapshot) != 2 {
        yield [false, ["snapshot-shape"]]
    }
    when kind(snapshot[0]) != "number" or snapshot[0] < 0 {
        yield [false, ["snapshot-version"]]
    }
    when kind(snapshot[1]) != "list" {
        yield [false, ["snapshot-entries"]]
    }
    vary keys := []
    vary errors := []
    each entry in snapshot[1] {
        when kind(entry) != "list" or size(entry) != 2 {
            change errors := push(errors, ["entry-shape", entry])
        } otherwise {
            when has_key(keys, entry[0]) {
                change errors := push(errors, ["duplicate-key", entry[0]])
            } otherwise {
                change keys := push(keys, entry[0])
            }
        }
    }
    yield [size(errors) == 0, errors]
}

craft has_key(keys, target) {
    vary found := false
    each key in keys {
        when key == target { change found := true }
    }
    yield found
}

export craft delete(snapshot, key) {
    make checked := validate_snapshot(snapshot)
    when not checked[0] { yield [false, snapshot, checked[1]] }
    make changed := remove_entry(snapshot[1], key)
    when not changed[1] { yield [false, snapshot, "key-not-found"] }
    yield [true, [snapshot[0] + 1, changed[0]], "deleted"]
}

export craft keys(snapshot) {
    make checked := validate_snapshot(snapshot)
    when not checked[0] { yield [false, [], checked[1]] }
    vary result := []
    each entry in snapshot[1] {
        change result := push(result, entry[0])
    }
    yield [true, result, "keys"]
}

export craft read_all(snapshot) {
    make checked := validate_snapshot(snapshot)
    when not checked[0] { yield [false, [], checked[1]] }
    yield [true, snapshot[1], snapshot[0]]
}

export craft apply_atomic(snapshot, operations) {
    make checked := validate_snapshot(snapshot)
    when not checked[0] { yield [false, snapshot, checked[1]] }
    when kind(operations) != "list" { yield [false, snapshot, "operations-must-be-list"] }
    vary next_entries := snapshot[1]
    vary errors := []
    each operation in operations {
        when kind(operation) != "list" or size(operation) != 3 {
            change errors := push(errors, ["operation-shape", operation])
        } otherwise {
            when operation[0] == "put" {
                change next_entries := put_entry(next_entries, operation[1], operation[2])
            } otherwise {
                when operation[0] == "delete" {
                    make removed := remove_entry(next_entries, operation[1])
                    when not removed[1] {
                        change errors := push(errors, ["key-not-found", operation[1]])
                    } otherwise {
                        change next_entries := removed[0]
                    }
                } otherwise {
                    change errors := push(errors, ["unknown-operation", operation[0]])
                }
            }
        }
    }
    when size(errors) > 0 { yield [false, snapshot, errors] }
    yield [true, [snapshot[0] + 1, next_entries], "committed"]
}
