{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivan-vhs.github.io/reaper/frameworks/catalog.v1.schema.json",
  "title": "Reaper Framework Catalogue v1",
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "version",
    "description",
    "registry_scope",
    "repository",
    "families",
    "integration_rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "ivan-vhs.reaper.framework-catalog.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "registry_scope": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "const": "Ivan-VHS/Reaper"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "maturity",
          "dependencies",
          "capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "base_branch": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "mainline",
              "open_pr",
              "open_draft_pr",
              "planned",
              "blocked",
              "archived"
            ]
          },
          "maturity": {
            "enum": [
              "Genesis",
              "Foundation",
              "Evolution",
              "Ascension",
              "Vanguard",
              "Frontier",
              "Dominion",
              "Apex",
              "Zenith",
              "Singularity",
              "Partial"
            ]
          },
          "pull_request": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "integration_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
