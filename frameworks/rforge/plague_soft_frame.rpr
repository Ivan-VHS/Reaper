# Plague — Soft Frame
# Soft surface lifecycle and frame geometry primitives.

export make FRAMEWORK_ID := "plague.soft_frame"
export make FRAMEWORK_VERSION := "1.0.0"
export make FRAMEWORK_PROFILE := "Soft Frame"

export craft soft_frame_opacity_valid(opacity) {
    yield opacity >= 0 and opacity <= 100
}

export craft soft_frame_phase_valid(phase) {
    yield phase == "draft" or phase == "active" or phase == "suspended" or phase == "closed"
}

export craft soft_frame_transition_allowed(current, next) {
    when current == next {
        yield soft_frame_phase_valid(current)
    }
    when current == "draft" {
        yield next == "active" or next == "closed"
    }
    when current == "active" {
        yield next == "suspended" or next == "closed"
    }
    when current == "suspended" {
        yield next == "active" or next == "closed"
    }
    yield false
}

export craft soft_frame_create(width, height, opacity) {
    when width > 0 and height > 0 and soft_frame_opacity_valid(opacity) {
        yield [FRAMEWORK_ID, width, height, opacity, "draft"]
    }
    yield []
}

export craft soft_frame_hit_test(x, y, width, height) {
    yield width > 0 and height > 0 and x >= 0 and y >= 0 and x < width and y < height
}
