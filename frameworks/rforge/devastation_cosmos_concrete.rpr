# Devastation — Cosmos Concrete
# Cosmos-first spatial cell addressing and concrete materialisation gates.

export make FRAMEWORK_ID := "devastation.cosmos_concrete"
export make FRAMEWORK_VERSION := "1.0.0"
export make FRAMEWORK_PROFILE := "Cosmos Concrete"

export craft devastation_cell_valid(x, y, z, width, height, depth) {
    yield width > 0 and height > 0 and depth > 0 and x >= 0 and y >= 0 and z >= 0 and x < width and y < height and z < depth
}

export craft devastation_cell_index(x, y, z, width, height, depth) {
    when devastation_cell_valid(x, y, z, width, height, depth) {
        yield x + y * width + z * width * height
    }
    yield -1
}

export craft devastation_bounds_valid(min_x, min_y, min_z, max_x, max_y, max_z) {
    yield min_x <= max_x and min_y <= max_y and min_z <= max_z
}

export craft devastation_materialise_allowed(cell_valid, bounds_valid, identity_unique) {
    yield cell_valid and bounds_valid and identity_unique
}

export craft devastation_region_capacity(entity_count, capacity) {
    yield entity_count >= 0 and capacity > 0 and entity_count <= capacity
}
