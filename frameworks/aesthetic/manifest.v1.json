  "not_implemented": [
    "first_class_reaper_struct_and_enum_syntax",
    "general_ast_hir_mir_lir_compiler_pipeline",
    "native_c17_backend_support_for_profile_modules_and_collections",
    "live_native_widget_renderer",
    "automated_visual_regression_capture",
    "repository_grant_authentication",
    "path_allowlist_enforcement",
    "source_patch_application",
    "sandboxed_command_execution",
    "automatic_branch_writes",
    "automatic_merge_or_release",
    "rollback_executor",
    "cryptographic_evidence_attestation"
