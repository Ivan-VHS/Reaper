  },
  "frameworks": [
    { "id": "vorke", "name": "Vorke", "module": "engine/vorke.rpr", "responsibility": "Nominal runtime type kernel, constructors, validators and invariants", "status": "source_present" },
    { "id": "jellymeat", "name": "Jellymeat", "module": "engine/jellymeat.rpr", "responsibility": "Versioned aesthetic profile catalogue", "status": "source_present" },
    { "id": "lejjyfish", "name": "LejjyFish", "module": "engine/lejjyfish.rpr", "responsibility": "High-level design IR construction", "status": "source_present" },
    { "id": "lejjy", "name": "Lejjy", "module": "engine/lejjy.rpr", "responsibility": "Deterministic HIR normalization and MIR passes", "status": "source_present" },
    { "id": "oplos", "name": "Oplos", "module": "engine/oplos.rpr", "responsibility": "Target-oriented MIR to LIR lowering", "status": "source_present" },
    { "id": "holmosaptimu", "name": "Holmosaptimu", "module": "engine/holmosaptimu.rpr", "responsibility": "Reaper profile compiler adapter", "status": "source_present" },
    { "id": "sentan", "name": "Sentan", "module": "engine/sentan.rpr", "responsibility": "Architecture graph validation and dependency-cycle analysis", "status": "source_present" },
    { "id": "cellene", "name": "Cellene", "module": "engine/cellene.rpr", "responsibility": "Design quality scoring and aesthetic profile proposals", "status": "source_present" },
    { "id": "kolir", "name": "Kolir", "module": "engine/kolir.rpr", "responsibility": "Bounded architecture, design and source change planning", "status": "source_present" },
    { "id": "somo", "name": "SOMO", "module": "engine/somo.rpr", "responsibility": "Deterministic evolution orchestration and evidence envelope", "status": "source_present" }
  ],
  "contracts": [
    "schemas/profile.v1.schema.json",
    "schemas/design-ir.v1.schema.json",
    "schemas/architecture-graph.v1.schema.json",
    "schemas/source-evolution-request.v1.schema.json"
  ],
  "built_in_profiles": ["dak_noir", "mora_studio"],
  "implemented_capabilities": [
    "nominal_tagged_profile_validation",
    "aesthetic_profile_catalogue",
    "aesthetic_hir_construction",
    "hir_to_mir_normalization",
    "reduced_motion_lowering",
    "mir_to_target_lir_lowering",
    "reaper_reference_runtime_compiler_adapter",
    "architecture_graph_validation",
    "dependency_cycle_detection",
    "design_quality_assessment",
    "design_evolution_proposal_generation",
    "bounded_source_evolution_plan_generation",
