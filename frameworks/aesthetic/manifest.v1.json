{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "ivan-vhs.reaper.aesthetic-evolution.manifest.v1",
  "name": "Reaper Aesthetic & Architecture Evolution Framework",
  "short_name": "RAAEF",
  "version": "1.0.0",
  "language": "Reaper",
  "entrypoint": "frameworks/aesthetic/all.rpr",
  "maturity_stage": "Genesis",
  "status": "source_present_runtime_validation_pending",
