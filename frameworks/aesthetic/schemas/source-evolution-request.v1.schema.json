{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivan-vhs.github.io/reaper/schemas/aesthetic-source-evolution-request.v1.schema.json",
  "title": "Reaper Source Evolution Request",
  "type": "array",
  "minItems": 9,
  "maxItems": 9,
  "prefixItems": [
    { "const": "SourceEvolutionRequest" },
    { "type": "string", "minLength": 1, "maxLength": 96 },
    { "type": "string", "pattern": "^sha256:[0-9A-Fa-f]{64}$" },
    {
      "type": "array", "minItems": 1, "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["architecture", "design", "source", "compiler", "tests", "documentation"]
      }
    },
    { "type": "integer", "minimum": 1, "maximum": 100 },
    { "type": "integer", "minimum": 1, "maximum": 1048576 },
    { "type": "number", "minimum": 0, "maximum": 100 },
    { "type": "number", "minimum": 0, "maximum": 100 },
    { "type": "boolean" }
  ],
  "items": false
}
