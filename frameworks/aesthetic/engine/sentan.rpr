# Sentan — bounded architecture graph validation and dependency-cycle analysis.
import "vorke.rpr" as Vorke

export craft get_id(node) {
    yield node[0]
}

export craft edge_exists(edges, source, destination) {
    each edge in edges {
        when edge[0] == source and edge[1] == destination {
            yield true
        }
    }
    yield false
}

export craft declares_dependency(nodes, source, destination) {
    each node in nodes {
        when node[0] == source {
            yield contains(node[2], destination)
        }
    }
    yield false
}

export craft has_path(edges, source, destination, visited, budget) {
    when source == destination {
        yield true
    }
    when budget <= 0 or contains(visited, source) {
        yield false
    }
    make next_visited := push(visited, source)
    each edge in edges {
        when edge[0] == source {
            when has_path(edges, edge[1], destination, next_visited, budget - 1) {
                yield true
            }
        }
    }
    yield false
}

export craft valid_graph(graph) {
    when kind(graph) != "list" or size(graph) != 5 {
        yield false
    }
    when graph[0] != "ArchitectureGraph" or graph[1] != Vorke["VERSION"] {
        yield false
    }
    when not Vorke["valid_text"](graph[2], 96)
        or kind(graph[3]) != "list" or kind(graph[4]) != "list" {
        yield false
    }
    when size(graph[3]) == 0 or size(graph[3]) > 256 or size(graph[4]) > 1024 {
        yield false
    }

    # Validate node tuple shapes before invoking get_id over the node list.
    each node in graph[3] {
        when kind(node) != "list" or size(node) != 3 {
            yield false
        }
        when not Vorke["valid_text"](node[0], 96)
            or not Vorke["valid_text"](node[1], 48)
            or kind(node[2]) != "list" or size(node[2]) > 256 {
            yield false
        }
        when size(unique(node[2])) != size(node[2]) {
            yield false
        }
    }

    make node_ids := map(graph[3], get_id)
    when size(unique(node_ids)) != size(node_ids) {
        yield false
    }

    vary edge_pairs := []
    each edge in graph[4] {
        when kind(edge) != "list" or size(edge) != 3 {
            yield false
        }
        when not contains(node_ids, edge[0]) or not contains(node_ids, edge[1]) {
            yield false
        }
        when edge[0] == edge[1] or not Vorke["valid_text"](edge[2], 48) {
            yield false
        }
        when contains(edge_pairs, [edge[0], edge[1]]) {
            yield false
        }
        when not declares_dependency(graph[3], edge[0], edge[1]) {
            yield false
        }
        change edge_pairs := push(edge_pairs, [edge[0], edge[1]])
    }

    each node in graph[3] {
        each dependency in node[2] {
            when dependency == node[0] or not contains(node_ids, dependency) {
                yield false
            }
            when not edge_exists(graph[4], node[0], dependency) {
                yield false
            }
        }
    }

    each edge in graph[4] {
        when has_path(graph[4], edge[1], edge[0], [], size(graph[3]) + 1) {
            yield false
        }
    }
    yield true
}

export craft inspect(graph) {
    when not valid_graph(graph) {
        yield ["ArchitectureAssessment", "blocked", ["invalid_graph_or_dependency_cycle"], 0]
    }
    yield ["ArchitectureAssessment", "valid", [], 100]
}

export craft compare(current_graph, proposed_graph) {
    make current_result := inspect(current_graph)
    make proposed_result := inspect(proposed_graph)
    when current_result[1] != "valid" or proposed_result[1] != "valid" {
        yield ["ArchitectureDelta", "blocked", ["invalid_current_or_proposed_graph"], 0]
    }

    vary changes := []
    when current_graph[3] != proposed_graph[3] {
        change changes := push(changes, "module_set_or_contracts_changed")
    }
    when current_graph[4] != proposed_graph[4] {
        change changes := push(changes, "dependency_edges_changed")
    }

    when size(changes) == 0 {
        yield ["ArchitectureDelta", "no_change", [], 0]
    }
    yield ["ArchitectureDelta", "review_required", changes, size(changes)]
}
