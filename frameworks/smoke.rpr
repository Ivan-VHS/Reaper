# End-to-end Reaper source smoke tests for the ten-framework family.
import "family.rpr" as family
import "Lokaliza/src/locale.rpr" as lokaliza
import "Sealise/src/blueprint.rpr" as sealise
import "Blebby/src/package.rpr" as blebby
import "Centen/src/resource.rpr" as centen
import "Kaso/src/template.rpr" as kaso
import "Shinnn/src/graph.rpr" as shinnn
import "Porteo/src/lifecycle.rpr" as porteo
import "Portable-Bortable/src/target.rpr" as portable_bortable
import "SWO/src/pipeline.rpr" as swo
import "ScoHOPE/src/application.rpr" as scohope

assert(family["framework_count"]() == 10, "family registry must expose ten frameworks")

make locales := [
    lokaliza["locale_record"]("en", "", "ltr"),
    lokaliza["locale_record"]("uk", "en", "ltr")
]
make locale_result := lokaliza["locale_register"](locales, lokaliza["locale_record"]("ru", "en", "ltr"))
assert(locale_result[0], "Lokaliza must register a valid locale")
assert(lokaliza["locale_resolve"](locale_result[1], "missing", "en")[0], "Lokaliza fallback must resolve")

make blueprint := sealise["blueprint_record"]("desktop-app", ["README.md", "src/main.rpr"], ["app", "service"], [1, 0, 0])
assert(sealise["blueprint_validate"](blueprint, ["README.md", "src/main.rpr"])[0], "Sealise must validate complete blueprints")
assert(not sealise["blueprint_validate"](blueprint, ["README.md"])[0], "Sealise must reject missing files")

make base_package := blebby["package_record"]("base", [1, 0, 0], [], "sha256-base")
make app_package := blebby["package_record"]("app", [1, 2, 0], [["base", [1, 0, 0]]], "sha256-app")
assert(blebby["package_check_dependencies"](app_package, [base_package])[0], "Blebby must resolve compatible dependencies")
assert(blebby["package_version_compare"]([2, 0, 0], [1, 9, 9])[1] == 1, "Blebby version comparison must be ordered")

make memory := centen["resource_record"]("memory", 64, 16, "MiB")
make reservation := centen["resource_reserve"](memory, 24)
assert(reservation[0] and reservation[1][2] == 40, "Centen must reserve within capacity")
assert(not centen["resource_reserve"](memory, 100)[0], "Centen must reject over-allocation")

make template := kaso["template_record"]("greeting", [["text", "Hello "], ["slot", "name"]], ["name"], [1, 0, 0])
make rendered := kaso["template_render"](template, [["name", "Reaper"]])
assert(rendered[0] and rendered[1] == "Hello Reaper", "Kaso must render required slots")

make valid_graph := shinnn["graph_validate"](["kernel", "app"], [["app", "kernel"]])
make cyclic_graph := shinnn["graph_validate"](["kernel", "app"], [["app", "kernel"], ["kernel", "app"]])
assert(valid_graph[0], "Shinnn must accept an acyclic graph")
assert(not cyclic_graph[0], "Shinnn must reject dependency cycles")

make core_component := porteo["component_record"]("core", [], "running", [])
make app_component := porteo["component_record"]("app", ["core"], "declared", [])
assert(porteo["component_prepare"](app_component, [core_component])[0], "Porteo must prepare after dependencies are running")

make source_target := portable_bortable["target_record"]("portable", "x86_64", 64, "little", "dabi64.v1", ["sse2"])
make host_target := portable_bortable["target_record"]("host", "x86_64", 64, "little", "dabi64.v1", ["sse2", "avx2"])
assert(portable_bortable["target_compatible"](source_target, host_target)[0], "Portable Bortable must accept a compatible target")
assert(not portable_bortable["target_compatible"](source_target, portable_bortable["target_record"]("bad", "arm64", 32, "little", "other", []))[0], "Portable Bortable must reject incompatible targets")

make compile_stage := swo["workflow_stage"]("compile", [], "passed", [])
make test_stage := swo["workflow_stage"]("test", ["compile"], "planned", [])
assert(swo["workflow_validate"]([compile_stage, test_stage])[0], "SWO must validate acyclic workflows")
assert(swo["workflow_can_start"](test_stage, [compile_stage, test_stage])[0], "SWO must enforce dependency readiness")

make application := scohope["application_record"]("editor", "desktop", [1, 0, 0], "en", ["window", "storage"], "configured")
assert(scohope["application_valid"](application)[0], "ScoHOPE must validate an application profile")
assert(scohope["application_environment_check"](application, ["window", "storage", "audio"])[0], "ScoHOPE must check environment capabilities")

emit "REAPER_FRAMEWORK_FAMILY_SMOKE_OK"
