# Blebby: package descriptors, semantic versions and dependency selection.
export craft package_record(name, version, dependencies, integrity) {
    yield [name, version, dependencies, integrity]
}

export craft package_version_valid(version) {
    when size(version) != 3 { yield false }
    when version[0] < 0 or version[1] < 0 or version[2] < 0 { yield false }
    yield true
}

export craft package_valid(package_info) {
    when size(package_info) != 4 { yield false }
    when size(package_info[0]) == 0 { yield false }
    when not package_version_valid(package_info[1]) { yield false }
    when size(package_info[3]) == 0 { yield false }
    yield true
}

export craft package_version_compare(left, right) {
    when not package_version_valid(left) or not package_version_valid(right) {
        yield [false, "invalid_version"]
    }
    when left[0] < right[0] { yield [true, -1] }
    when left[0] > right[0] { yield [true, 1] }
    when left[1] < right[1] { yield [true, -1] }
    when left[1] > right[1] { yield [true, 1] }
    when left[2] < right[2] { yield [true, -1] }
    when left[2] > right[2] { yield [true, 1] }
    yield [true, 0]
}

export craft package_find(packages, package_name) {
    vary index := 0
    loop while index < size(packages) {
        make candidate := packages[index]
        when candidate[0] == package_name { yield [true, candidate] }
        change index := index + 1
    }
    yield [false, "package_not_found"]
}

export craft package_dependency_satisfied(requirement, packages) {
    when size(requirement) != 2 { yield [false, "invalid_requirement"] }
    make found := package_find(packages, requirement[0])
    when not found[0] { yield [false, found[1]] }
    make comparison := package_version_compare(found[1][1], requirement[1])
    when not comparison[0] { yield comparison }
    when comparison[1] < 0 { yield [false, "version_below_minimum"] }
    yield [true, found[1]]
}

export craft package_check_dependencies(package_info, packages) {
    when not package_valid(package_info) { yield [false, "invalid_package"] }
    vary index := 0
    loop while index < size(package_info[2]) {
        make result := package_dependency_satisfied(package_info[2][index], packages)
        when not result[0] { yield [false, result[1]] }
        change index := index + 1
    }
    yield [true, []]
}

export craft package_register(packages, package_info) {
    when not package_valid(package_info) { yield [false, "invalid_package"] }
    make existing := package_find(packages, package_info[0])
    when existing[0] { yield [false, "package_already_registered"] }
    make dependencies := package_check_dependencies(package_info, packages)
    when not dependencies[0] { yield dependencies }
    yield [true, push(packages, package_info)]
}


# Version ranges, immutable lock snapshots and provenance records.
export craft package_version_satisfies(version, minimum, maximum) {
    when not package_version_valid(version) or not package_version_valid(minimum) { yield [false, "invalid_version"] }
    make lower := package_version_compare(version, minimum)
    when lower[1] < 0 { yield [true, false] }
    when size(maximum) == 0 { yield [true, true] }
    when not package_version_valid(maximum) { yield [false, "invalid_maximum"] }
    make upper := package_version_compare(version, maximum)
    yield [true, upper[1] <= 0]
}
export craft package_constraint(name, minimum, maximum) {
    yield [name, minimum, maximum]
}
export craft package_constraint_check(constraint, packages) {
    when size(constraint) != 3 { yield [false, "invalid_constraint"] }
    make found := package_find(packages, constraint[0])
    when not found[0] { yield found }
    make match := package_version_satisfies(found[1][1], constraint[1], constraint[2])
    when not match[0] { yield match }
    when not match[1] { yield [false, "version_outside_range"] }
    yield [true, found[1]]
}
export craft package_registry_validate(packages) {
    vary index := 0
    loop while index < size(packages) {
        when not package_valid(packages[index]) { yield [false, "invalid_package"] }
        vary other := index + 1
        loop while other < size(packages) {
            when packages[index][0] == packages[other][0] { yield [false, "duplicate_package_name"] }
            change other := other + 1
        }
        change index := index + 1
    }
    yield [true, []]
}
export craft package_lockfile_build(packages) {
    make valid := package_registry_validate(packages)
    when not valid[0] { yield valid }
    vary entries := []
    vary index := 0
    loop while index < size(packages) {
        change entries := push(entries, [packages[index][0], packages[index][1], packages[index][3]])
        change index := index + 1
    }
    yield [true, ["reaper.lock.v1", entries]]
}
export craft package_lockfile_validate(lockfile, packages) {
    when size(lockfile) != 2 or lockfile[0] != "reaper.lock.v1" { yield [false, "unsupported_lockfile"] }
    when size(lockfile[1]) != size(packages) { yield [false, "lockfile_cardinality_mismatch"] }
    vary index := 0
    loop while index < size(packages) {
        when lockfile[1][index] != [packages[index][0], packages[index][1], packages[index][3]] {
            yield [false, "lockfile_mismatch"]
        }
        change index := index + 1
    }
    yield [true, []]
}
export craft package_provenance(name, version, source, publisher, reviewed) {
    yield [name, version, source, publisher, reviewed]
}
export craft package_provenance_valid(record) {
    when size(record) != 5 { yield false }
    when size(record[0]) == 0 or size(record[2]) == 0 or size(record[3]) == 0 { yield false }
    when record[4] != true and record[4] != false { yield false }
    yield true
}
export craft package_dependency_closure(name, packages, visited) {
    when size(visited) > size(packages) { yield [false, "dependency_budget_exceeded"] }
    when contains(visited, name) { yield [true, visited] }
    make found := package_find(packages, name)
    when not found[0] { yield [false, "dependency_missing:" ++ name] }
    vary closure := push(visited, name)
    vary index := 0
    loop while index < size(found[1][2]) {
        make next := package_dependency_closure(found[1][2][index][0], packages, closure)
        when not next[0] { yield next }
        change closure := next[1]
        change index := index + 1
    }
    yield [true, closure]
}


# Package selection, registry audits and dependency change impact.
export craft package_find_all(packages, package_name) {
    vary matches := []
    vary index := 0
    loop while index < size(packages) {
        when size(packages[index]) == 4 and packages[index][0] == package_name {
            change matches := push(matches, packages[index])
        }
        change index := index + 1
    }
    yield matches
}

export craft package_select_version(packages, package_name, minimum, maximum) {
    vary selected := []
    vary found := false
    vary index := 0
    loop while index < size(packages) {
        when packages[index][0] == package_name {
            make accepted := package_version_satisfies(packages[index][1], minimum, maximum)
            when accepted[0] and accepted[1] {
                when not found {
                    change selected := packages[index]
                    change found := true
                } otherwise {
                    make newer := package_version_compare(packages[index][1], selected[1])
                    when newer[0] and newer[1] > 0 { change selected := packages[index] }
                }
            }
        }
        change index := index + 1
    }
    when found { yield [true, selected] }
    yield [false, "no_compatible_package_version"]
}

export craft package_registry_audit(registry) {
    vary issues := []
    vary index := 0
    loop while index < size(registry) {
        when size(registry[index]) != 2 {
            change issues := push(issues, [index, "invalid_registry_entry"])
        } otherwise {
            when not package_valid(registry[index][0]) {
                change issues := push(issues, [index, "invalid_package"])
            }
            when not package_provenance_valid(registry[index][1]) {
                change issues := push(issues, [index, "invalid_provenance"])
            }
        }
        change index := index + 1
    }
    yield [size(issues) == 0, issues]
}

export craft package_registry_candidates(registry, package_name) {
    vary candidates := []
    vary index := 0
    loop while index < size(registry) {
        when size(registry[index]) == 2 and registry[index][0][0] == package_name {
            change candidates := push(candidates, registry[index])
        }
        change index := index + 1
    }
    yield candidates
}

export craft package_remove_impact(packages, package_name) {
    make target := package_find(packages, package_name)
    when not target[0] { yield [false, "package_not_found"] }
    vary dependents := []
    vary index := 0
    loop while index < size(packages) {
        vary dependency_index := 0
        loop while dependency_index < size(packages[index][2]) {
            when packages[index][2][dependency_index][0] == package_name {
                change dependents := push(dependents, packages[index][0])
            }
            change dependency_index := dependency_index + 1
        }
        change index := index + 1
    }
    yield [true, dependents]
}

export craft package_replace_version(packages, package_name, new_version) {
    when not package_version_valid(new_version) { yield [false, "invalid_version"] }
    vary result := []
    vary replaced := false
    vary index := 0
    loop while index < size(packages) {
        when packages[index][0] == package_name {
            change result := push(result, [
                packages[index][0], new_version, packages[index][2], packages[index][3]
            ])
            change replaced := true
        } otherwise {
            change result := push(result, packages[index])
        }
        change index := index + 1
    }
    when not replaced { yield [false, "package_not_found"] }
    yield [true, result]
}

export craft package_lock_diff(before, after) {
    when size(before) != 2 or size(after) != 2 { yield [false, "invalid_lockfile"] }
    vary added := []
    vary removed := []
    vary changed := []
    vary index := 0
    loop while index < size(after[1]) {
        make old_index := 0
        vary found := false
        loop while old_index < size(before[1]) {
            when before[1][old_index][0] == after[1][index][0] {
                change found := true
                when before[1][old_index] != after[1][index] {
                    change changed := push(changed, [before[1][old_index], after[1][index]])
                }
            }
            change old_index := old_index + 1
        }
        when not found { change added := push(added, after[1][index]) }
        change index := index + 1
    }
    vary old_index := 0
    loop while old_index < size(before[1]) {
        when not package_lock_has(after[1], before[1][old_index][0]) {
            change removed := push(removed, before[1][old_index])
        }
        change old_index := old_index + 1
    }
    yield [true, added, removed, changed]
}

export craft package_lock_has(entries, name) {
    vary index := 0
    loop while index < size(entries) {
        when entries[index][0] == name { yield true }
        change index := index + 1
    }
    yield false
}
