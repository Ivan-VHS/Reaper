{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reaper-lang.org/schemas/rivet.product.v1.schema.json",
  "title": "Rivet Composed Product Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "kind",
    "version",
    "target",
    "modules",
    "dependency_graph",
    "permissions",
    "maturity",
    "build_state",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "reaper.rivet.product.v1"},
    "id": {"type": "string", "pattern": "^[a-f0-9]{16,64}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 96},
    "kind": {"enum": ["framework", "multitool", "hybrid"]},
    "version": {"type": "string", "maxLength": 64},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "profile", "architecture"],
      "properties": {
        "language": {"const": "reaper"},
        "profile": {"enum": ["desktop", "service", "native", "embedded", "dak-userland"]},
        "architecture": {"enum": ["x86_64", "aarch64", "elbrus", "portable"]}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "maturity"],
        "properties": {
          "id": {"type": "string", "maxLength": 96},
          "version": {"type": "string", "maxLength": 64},
          "maturity": {"enum": ["specification_only", "source_only", "implemented", "verified", "installable"]},
          "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "dependency_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "signature"],
      "properties": {
        "nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 96}},
        "edges": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "kind"],
            "properties": {
              "from": {"type": "string", "maxLength": 96},
              "to": {"type": "string", "maxLength": 96},
              "kind": {"enum": ["depends_on", "provides", "requires", "event", "extension"]}
            }
          }
        },
        "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "granted"],
      "properties": {
        "requested": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 96}},
        "granted": {"type": "array", "uniqueItems": true, "maxItems": 0}
      }
    },
    "maturity": {"enum": ["specification_only", "source_only", "implemented", "verified", "installable"]},
    "build_state": {"enum": ["plan_only", "scaffolded", "source_generated", "verified", "packaged", "installable"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": {"type": "string", "maxLength": 256},
          "role": {"enum": ["source", "contract", "test", "documentation", "binary", "sbom", "provenance"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_revision", "builder", "reproducible"],
      "properties": {
        "source_revision": {"type": "string", "maxLength": 64},
        "builder": {"const": "reaper-rivet"},
        "reproducible": {"type": "boolean"},
        "sbom_path": {"type": "string", "maxLength": 256},
        "signature_path": {"type": "string", "maxLength": 256}
      }
    }
  }
}
