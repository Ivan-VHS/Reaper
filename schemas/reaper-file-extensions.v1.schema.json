{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/Reaper/blob/main/schemas/reaper-file-extensions.v1.schema.json",
  "title": "Reaper file extension planning registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "scope",
    "authority",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "reaper.file-extensions.v1"
    },
    "version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authority": {
      "const": "docs/FILE_FORMATS_AND_EXTENSIONS_V1.md"
    },
    "extensions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "extension",
          "role",
          "domain",
          "contract_state",
          "implementation_state",
          "parser_status",
          "invariants",
          "depends_on",
          "hot_reload"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "extension": {
            "type": "string",
            "pattern": "^\\.[a-z][a-z0-9]{0,7}$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "contract_state": {
            "enum": [
              "specified",
              "external_contract"
            ]
          },
          "implementation_state": {
            "enum": [
              "planned",
              "external"
            ]
          },
          "parser_status": {
            "enum": [
              "not_implemented",
              "external_not_supported"
            ]
          },
          "invariants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "depends_on": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "hot_reload": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
