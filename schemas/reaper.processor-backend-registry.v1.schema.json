{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reaper.dev/schemas/reaper.processor-backend-registry.v1.schema.json",
  "title": "Reaper Processor Backend Prototype Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "registry_generation",
    "backends"
  ],
  "properties": {
    "schema": {
      "const": "reaper.processor-backend-registry.v1"
    },
    "version": {
      "const": 1
    },
    "registry_generation": {
      "type": "integer",
      "minimum": 1
    },
    "backends": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "maturity",
          "target",
          "abi",
          "input_contract",
          "output_contract",
          "entrypoints",
          "source_refs",
          "test_refs",
          "deterministic",
          "bounded",
          "qualification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "kind": {
            "enum": [
              "native-assembler",
              "native-linker",
              "emulator",
              "rtl",
              "formal-verification"
            ]
          },
          "maturity": {
            "enum": [
              "specified",
              "prototype",
              "implemented",
              "target-qualified",
              "hardware-qualified",
              "disabled"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "abi": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "input_contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "output_contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "entrypoints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256
            }
          },
          "test_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256
            }
          },
          "deterministic": {
            "type": "boolean"
          },
          "bounded": {
            "const": true
          },
          "toolchain": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "resource_limits": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "integer",
                "string",
                "boolean"
              ]
            }
          },
          "qualification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_qualified",
              "hardware_qualified",
              "abi_conformance"
            ],
            "properties": {
              "target_qualified": {
                "const": false
              },
              "hardware_qualified": {
                "const": false
              },
              "abi_conformance": {
                "enum": [
                  "not-assessed",
                  "partial",
                  "passed"
                ]
              }
            }
          },
          "execution_performed": {
            "const": false
          },
          "hardware_access_performed": {
            "const": false
          }
        }
      }
    }
  }
}
