{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://github.com/Ivan-VHS/Reaper/blob/main/schemas/reaper.pytyliki-iron-core-bridge.v1.schema.json",
 "title":"Reaper Pytyliki Iron Core Bridge v1",
 "type":"object","additionalProperties":false,
 "required":["schema_version","source_bytes","version_label","verification_claim","policy_declarations","blocks"],
 "properties":{
  "schema_version":{"const":1},
  "source_bytes":{"type":"integer","minimum":1,"maximum":1048576},
  "version_label":{"type":"string","minLength":1,"maxLength":95,"pattern":"^[A-Za-z0-9_.-]+$"},
  "verification_claim":{"type":"string","minLength":1,"maxLength":95,"pattern":"^[A-Za-z0-9_.-]+$"},
  "policy_declarations":{"type":"integer","minimum":1},
  "blocks":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","additionalProperties":false,
   "required":["semantic_id","start_offset","body_offset","body_length","end_offset","line","closed"],
   "properties":{
    "semantic_id":{"enum":["core.context","system.context","level.context","selection.filter","operation.unit","work.massive","startup.plan","work.spawn.plan","implementation.binding","utility.helper","layout.unify","branchpass.plan","tournament.rank","execution.jump.plan","logic.true_connective"]},
    "start_offset":{"type":"integer","minimum":0},"body_offset":{"type":"integer","minimum":0},
    "body_length":{"type":"integer","minimum":0},"end_offset":{"type":"integer","minimum":0},
    "line":{"type":"integer","minimum":1},"closed":{"const":true}
   }}},
  "source_claim_only":{"const":true},"typed_lowering_performed":{"const":false},
  "execution_performed":{"const":false},"hardware_effects_performed":{"const":false}
 }
}
