{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivan-vhs.github.io/reaper/schemas/plague.repository-profile.v1.schema.json",
  "title": "PLAGUE Repository Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository_id",
    "platform",
    "stack",
    "max_changed_paths",
    "max_patch_bytes",
    "granted_scopes",
    "required_gates",
    "require_rollback",
    "approval_mode",
    "approval_threshold",
    "max_risk"
  ],
  "properties": {
    "schema": { "const": "reaper.plague.repository-profile.v1" },
    "repository_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
    "stack": { "type": "string", "minLength": 1, "maxLength": 128 },
    "max_changed_paths": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "max_patch_bytes": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "granted_scopes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "require_rollback": { "type": "boolean" },
    "approval_mode": { "enum": ["manual", "risk_based"] },
    "approval_threshold": { "type": "number", "minimum": 0, "maximum": 100 },
    "max_risk": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
