{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckos.local/schemas/jora.application.v1.schema.json",
  "title": "Jora Application Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "id",
    "name",
    "description",
    "formula",
    "components",
    "dependency_order",
    "dependencies",
    "locales",
    "preferred_locale",
    "syntax",
    "implementation",
    "installable",
    "executable_capabilities",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "reaper.jora.application.v1"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "components"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text.editor",
              "audio.editor",
              "translation.workspace"
            ]
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "domain",
          "summary",
          "provides",
          "requires",
          "maturity",
          "generated_unit"
        ],
        "properties": {
          "id": {
            "enum": [
              "text.editor",
              "audio.editor",
              "translation.workspace"
            ]
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maturity": {
            "const": "specification_only"
          },
          "generated_unit": {
            "type": "string"
          }
        }
      }
    },
    "dependency_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "maturity",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "maturity": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "en",
          "ru",
          "uk",
          "most"
        ]
      }
    },
    "preferred_locale": {
      "enum": [
        "en",
        "ru",
        "uk",
        "most"
      ]
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status"
      ],
      "properties": {
        "mode": {
          "const": "flow"
        },
        "status": {
          "const": "implemented"
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_language",
        "targets",
        "runtime",
        "maturity"
      ],
      "properties": {
        "canonical_language": {
          "const": "reaper"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "language",
              "status",
              "reason"
            ],
            "properties": {
              "id": {
                "enum": [
                  "reaper",
                  "java",
                  "kotlin",
                  "python",
                  "typescript",
                  "rust",
                  "c"
                ]
              },
              "language": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "generated",
                  "adapter_pending"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "runtime": {
          "const": "reaper-reference"
        },
        "maturity": {
          "const": "scaffold_only"
        }
      }
    },
    "installable": {
      "const": false
    },
    "executable_capabilities": {
      "type": "array",
      "maxItems": 0
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
