{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reaper-lang.org/schemas/rivet.request.v1.schema.json",
  "title": "Rivet Product Composition Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "kind",
    "root_modules",
    "target",
    "offline",
    "permissions"
  ],
  "properties": {
    "schema": {
      "const": "reaper.rivet.request.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "kind": {
      "enum": ["framework", "multitool", "hybrid"]
    },
    "root_modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
        "maxLength": 96
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "profile", "architecture"],
      "properties": {
        "language": {
          "const": "reaper"
        },
        "profile": {
          "enum": ["desktop", "service", "native", "embedded", "dak-userland"]
        },
        "architecture": {
          "enum": ["x86_64", "aarch64", "elbrus", "portable"]
        }
      }
    },
    "optimization": {
      "enum": ["balanced", "low_latency", "modularity", "extensibility", "minimal_complexity"],
      "default": "balanced"
    },
    "offline": {
      "type": "boolean",
      "const": true
    },
    "registries": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri", "trust"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "uri": {"type": "string", "pattern": "^file://", "minLength": 1, "maxLength": 512},
          "trust": {"enum": ["local", "pinned-key", "signed-index"]}
        }
      },
      "default": []
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "network", "process", "device", "user_approval"],
      "properties": {
        "requested": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {"type": "string", "maxLength": 96}
        },
        "network": {"const": false},
        "process": {"const": false},
        "device": {"const": false},
        "user_approval": {"const": true}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_modules": {"type": "integer", "minimum": 1, "maximum": 64, "default": 24},
        "max_graph_edges": {"type": "integer", "minimum": 0, "maximum": 512, "default": 256},
        "memory_bytes": {"type": "integer", "minimum": 1048576, "maximum": 1073741824, "default": 67108864}
      }
    }
  }
}
