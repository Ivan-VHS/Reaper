{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/Reaper/blob/main/schemas/processor-workbench-report.v1.schema.json",
  "title": "Reaper Processor Workbench Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "project_name",
    "target",
    "host",
    "benchmark",
    "compiler",
    "hardware_effects",
    "maturity"
  ],
  "properties": {
    "schema": {
      "const": "reaper.processor-workbench-report.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "project_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 96
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "triple",
        "abi",
        "address_bits",
        "endianness",
        "required_isa",
        "minimum_logical_processors"
      ],
      "properties": {
        "architecture": {
          "type": "string"
        },
        "triple": {
          "type": "string"
        },
        "abi": {
          "type": "string"
        },
        "address_bits": {
          "enum": [
            32,
            64
          ]
        },
        "endianness": {
          "enum": [
            "little",
            "big"
          ]
        },
        "required_isa": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimum_logical_processors": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "cpu",
        "vendor",
        "logical_processors",
        "available_memory_mib",
        "usable_isa"
      ],
      "properties": {
        "architecture": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "logical_processors": {
          "type": "integer",
          "minimum": 1
        },
        "available_memory_mib": {
          "type": "integer",
          "minimum": 0
        },
        "usable_isa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sse2",
            "sse4_2",
            "avx_hardware",
            "osxsave",
            "avx_usable",
            "avx2_usable",
            "avx512f_usable",
            "aes",
            "fma_usable",
            "virtualization"
          ],
          "properties": {
            "sse2": {
              "type": "boolean"
            },
            "sse4_2": {
              "type": "boolean"
            },
            "avx_hardware": {
              "type": "boolean"
            },
            "osxsave": {
              "type": "boolean"
            },
            "avx_usable": {
              "type": "boolean"
            },
            "avx2_usable": {
              "type": "boolean"
            },
            "avx512f_usable": {
              "type": "boolean"
            },
            "aes": {
              "type": "boolean"
            },
            "fma_usable": {
              "type": "boolean"
            },
            "virtualization": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "schema",
        "repeat",
        "warmup_runs",
        "measured_runs",
        "statistics",
        "timing_note",
        "all_integrity_checks_passed"
      ],
      "properties": {
        "producer": {
          "const": "Pytyliki"
        },
        "schema": {
          "const": "pytyliki.suite.v1"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "measured_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "statistics": {
          "type": "object",
          "additionalProperties": true
        },
        "timing_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "all_integrity_checks_passed": {
          "type": "boolean"
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_language",
        "backend",
        "execution_scope",
        "target_qualified",
        "cross_compilation"
      ],
      "properties": {
        "source_language": {
          "const": "Reaper"
        },
        "backend": {
          "const": "scalar-c17"
        },
        "execution_scope": {
          "const": "host-only"
        },
        "target_qualified": {
          "const": false
        },
        "cross_compilation": {
          "const": false
        }
      }
    },
    "hardware_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processor_settings_changed",
        "affinity_changed",
        "device_registers_written",
        "firmware_or_microcode_written",
        "drivers_changed"
      ],
      "properties": {
        "processor_settings_changed": {
          "const": false
        },
        "affinity_changed": {
          "const": false
        },
        "device_registers_written": {
          "const": false
        },
        "firmware_or_microcode_written": {
          "const": false
        },
        "drivers_changed": {
          "const": false
        }
      }
    },
    "maturity": {
      "const": "host-scalar-aot-and-read-only-pytyliki-evidence"
    }
  }
}
