{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reaper-lang.org/schemas/jora.request.v1.schema.json",
  "title": "Jora Application Composition Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "reaper.jora.request.v1"
    },
    "application_name_policy": {
      "const": "no_platform_brand_in_application_name"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!.*[Jj][Oo][Rr][Aa]).+$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "enum": [
          "text.editor",
          "audio.editor",
          "translation.workspace",
          "subtitle.editor",
          "notes.workspace",
          "task.board",
          "calendar.scheduler",
          "speech.synthesis",
          "speech.recognition",
          "code.editor",
          "spreadsheet.editor",
          "image.editor",
          "video.editor",
          "presentation.editor",
          "file.manager",
          "api.client",
          "automation.engine",
          "data.visualizer",
          "database.manager",
          "archive.manager",
          "knowledge.graph"
        ]
      }
    },
    "locales": {
      "oneOf": [
        {
          "const": "auto"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "en",
              "ru",
              "uk",
              "most",
              "en-US",
              "ru-RU",
              "uk-UA",
              "ua"
            ]
          }
        }
      ]
    },
    "preferred_locale": {
      "enum": [
        "en",
        "ru",
        "uk",
        "most",
        "en-US",
        "ru-RU",
        "uk-UA",
        "ua"
      ]
    },
    "syntax_mode": {
      "const": "flow"
    },
    "language_targets": {
      "oneOf": [
        {
          "const": "auto"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reaper",
              "java",
              "kotlin",
              "python",
              "typescript",
              "rust",
              "c"
            ]
          }
        }
      ]
    },
    "name_style": {
      "enum": [
        "compact",
        "balanced",
        "descriptive",
        "formula"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topology": {
          "enum": [
            "auto",
            "layered",
            "pipeline",
            "hub_spoke",
            "plugin_mesh",
            "event_driven",
            "hybrid"
          ]
        },
        "seed": {
          "type": "string",
          "maxLength": 64
        },
        "variants": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "variation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "objective": {
          "enum": [
            "balanced",
            "low_latency",
            "modularity",
            "extensibility",
            "minimal_complexity"
          ]
        }
      }
    }
  }
}
