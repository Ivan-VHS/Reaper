{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reaper-lang.org/schemas/jora.request.v1.schema.json",
  "title": "Jora Application Composition Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "reaper.jora.request.v1"
    },
    "name": {
      "const": "Jora"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "enum": [
          "text.editor",
          "audio.editor",
          "translation.workspace"
        ]
      }
    },
    "locales": {
      "oneOf": [
        {
          "const": "auto"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "en",
              "ru",
              "uk",
              "most",
              "en-US",
              "ru-RU",
              "uk-UA",
              "ua"
            ]
          }
        }
      ]
    },
    "preferred_locale": {
      "enum": [
        "en",
        "ru",
        "uk",
        "most",
        "en-US",
        "ru-RU",
        "uk-UA",
        "ua"
      ]
    },
    "syntax_mode": {
      "const": "flow"
    },
    "language_targets": {
      "oneOf": [
        {
          "const": "auto"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reaper",
              "java",
              "kotlin",
              "python",
              "typescript",
              "rust",
              "c"
            ]
          }
        }
      ]
    }
  }
}
