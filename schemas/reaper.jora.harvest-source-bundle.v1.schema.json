{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/Reaper/schemas/reaper.jora.source-bundle.v1.schema.json",
  "title": "Reaper Jora HARVEST Source Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack_id",
    "version",
    "archive_sha256",
    "runtime",
    "framework_ids",
    "core_files",
    "schema_files",
    "registry_file",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "harvest.jora.source-bundle.v1"
    },
    "pack_id": {
      "const": "harvest.frameworks"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime": {
      "const": "reaper-reference"
    },
    "framework_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^harvest\\.[a-z0-9_]{1,40}$"
      }
    },
    "core_files": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]{1,48}\\.rpr$"
      }
    },
    "schema_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]{1,96}\\.schema\\.json$"
      }
    },
    "registry_file": {
      "const": "harvest.registry.v1.json"
    },
    "status": {
      "const": "authored_unverified"
    },
    "files_copied": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "bytes_copied": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    }
  }
}
