# ДОМ adapters for the eighteen standalone Reaper framework modules.
# This layer reuses each module through its public contract; it does not copy
# their algorithms into the ДОМ runtime or give them independent authority.

import "../../frameworks/galhero.rpr" as galhero
import "../../frameworks/call_and_back.rpr" as call_back
import "../../frameworks/stacked_options.rpr" as options
import "../../frameworks/perenosimost.rpr" as perenosimost
import "../../frameworks/most.rpr" as most
import "../../frameworks/blau.rpr" as blau
import "../../frameworks/shashio.rpr" as shashio
import "../../frameworks/showel_fleppery_code.rpr" as showel
import "../../frameworks/vorke.rpr" as vorke
import "../../frameworks/jellymeat.rpr" as jellymeat
import "../../frameworks/lejjyfish.rpr" as lejjyfish
import "../../frameworks/lejjy.rpr" as lejjy
import "../../frameworks/oplos.rpr" as oplos
import "../../frameworks/holmosaptimu.rpr" as holmosaptimu
import "../../frameworks/sentan.rpr" as sentan
import "../../frameworks/cellene.rpr" as cellene
import "../../frameworks/kolir.rpr" as kolir
import "../../frameworks/somo.rpr" as somo

export craft resolve_module_graph(nodes, edges) {
    yield galhero["topological_order"](nodes, edges)
}

export craft resolve_configuration(defaults, profile, workspace, request, rules) {
    make resolved := options["resolve"](defaults, profile, workspace, request)
    yield options["validate"](resolved, rules)
}

export craft dispatch_callbacks(registry, event, payload) {
    yield call_back["dispatch"](registry, event, payload)
}

export craft normalize_most_word(word) {
    yield [
        perenosimost["canonical"](word),
        perenosimost["support"](word),
        most["classify"](word)
    ]
}

export craft empty_snapshot() {
    yield blau["empty"]()
}

export craft update_snapshot(snapshot, expected_version, key, value) {
    yield blau["compare_and_set"](snapshot, expected_version, key, value)
}

export craft apply_state_events(initial_state, events, transitions) {
    yield shashio["apply_atomic"](initial_state, events, transitions)
}

export craft transform_in_memory(pipeline, source) {
    yield showel["run"](pipeline, source)
}

export craft graph_layers(nodes, edges) {
    yield galhero["topological_layers"](nodes, edges)
}

export craft unsubscribe_callback(registry, event, callback) {
    yield call_back["unsubscribe"](registry, event, callback)
}

export craft resolve_configuration_provenance(defaults, profile, workspace, request) {
    yield options["resolve_with_sources"](defaults, profile, workspace, request)
}

export craft validate_most_profile() {
    yield most["validate_profile"]()
}

export craft apply_snapshot_operations(snapshot, operations) {
    yield blau["apply_atomic"](snapshot, operations)
}

export craft reachable_states(states, transitions, initial_state) {
    yield shashio["reachable_states"](states, transitions, initial_state)
}

export craft run_bounded_transform(pipeline, source, max_steps) {
    yield showel["run_bounded"](pipeline, source, max_steps)
}


# New v1.1 adapters. The underlying frameworks retain domain ownership.
export craft standalone_module_count() {
    yield 18
}

export craft standalone_module_names() {
    yield [
        "GalHero", "Call-and-Back", "Stacked Options", "PerenosiMOST",
        "MOST", "Blau", "Shashio", "Showel Fleppery CODE",
        "Vorke", "Jellymeat", "LejjyFish", "Lejjy", "Oplos",
        "Holmosaptimu", "Sentan", "Cellene", "Kolir", "SOMO"
    ]
}

export craft validate_application_manifest(manifest) {
    yield vorke["validate_manifest"](manifest)
}

export craft plan_application_start(manifest) {
    yield vorke["phase_plan"](manifest)
}

export craft validate_data_record(schema, record) {
    yield jellymeat["validate_record"](schema, record)
}

export craft project_data_record(record, fields) {
    yield jellymeat["project"](record, fields)
}

export craft append_stream_event(events, event, capacity) {
    yield lejjyfish["append"](events, event, capacity)
}

export craft resolve_service_provider(bindings, service_id) {
    yield lejjy["resolve"](bindings, service_id)
}

export craft validate_service_scopes(bindings, requests) {
    yield lejjy["validate_dependencies"](bindings, requests)
}

export craft validate_transport_routes(routes) {
    yield oplos["validate_routes"](routes)
}

export craft summarize_local_metric(catalog, samples, metric_id) {
    yield holmosaptimu["summarize"](catalog, samples, metric_id)
}

export craft evaluate_policy_rules(rules, request) {
    yield sentan["evaluate"](rules, request)
}

export craft validate_component_composition(manifests, abi_major, abi_minor) {
    yield cellene["validate_composition"](manifests, abi_major, abi_minor)
}

export craft validate_ui_tree(nodes) {
    yield kolir["validate_tree"](nodes)
}

export craft evaluate_test_scenario(scenario, outcomes) {
    yield somo["evaluate"](scenario, outcomes)
}

export craft compare_replay_traces(expected_trace, actual_trace) {
    yield somo["replay_equal"](expected_trace, actual_trace)
}
