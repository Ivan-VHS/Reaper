{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ivan-vhs:plague:schema:evolution-proposal:v1",
  "title": "PLAGUE evolution proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "platform",
    "stack",
    "changed_paths",
    "patch_bytes",
    "requested_scopes",
    "completed_gates",
    "rollback_available",
    "risk",
    "expected_benefit",
    "evidence_refs",
    "baseline_digest"
  ],
  "properties": {
    "schema": { "const": "ivan-vhs.plague.evolution-proposal.v1" },
    "proposal_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
    "stack": { "type": "string", "minLength": 1, "maxLength": 128 },
    "changed_paths": { "type": "integer", "minimum": 1, "maximum": 100 },
    "patch_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "requested_scopes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "completed_gates": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "rollback_available": { "type": "boolean" },
    "risk": { "type": "number", "minimum": 0, "maximum": 100 },
    "expected_benefit": { "type": "number", "minimum": 0, "maximum": 100 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "baseline_digest": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
