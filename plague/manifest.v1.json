      "status": "planned"
    },
    {
      "id": "maladrix",
      "name": "Maladrix",
      "responsibility": "Performance, resource and resilience engineering",
      "status": "planned"
    },
    {
      "id": "necrovex",
      "name": "Necrovex",
      "responsibility": "Recovery, migrations and compatibility repair",
      "status": "planned"
