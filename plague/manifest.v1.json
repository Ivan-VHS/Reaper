{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "ivan-vhs.plague.manifest.v1",
  "name": "PLAGUE",
  "version": "1.0.0",
  "release_label": "foundation",
  "maturity_stage": "Genesis",
  "status": "foundation",
