    "versioned_change_plan_contract",
    "versioned_evidence_contract",
    "versioned_repository_profile_contract",
    "versioned_evolution_proposal_contract"
  ],
  "not_implemented": [
    "repository_discovery_adapter",
    "filesystem_read_adapter",
    "filesystem_write_adapter",
    "source_language_adapters",
    "cross_repository_graph_ingestion",
    "autonomous_patch_engine",
    "sandboxed_command_runner",
    "persistent_audit_store",
    "rollback_executor",
    "runtime_feature_evidence_collector",
    "repository_grant_validation",
    "path_allowlist_enforcement",
    "evidence_reference_verification"
